---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, getReadingTime } from '../utils/posts';

const allPosts = await getPublishedPosts();

const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))].sort();
---

<BaseLayout title="Home">
  <section class="page-header">
    <h1 class="page-header__title">Latest Posts</h1>
    <p class="page-header__subtitle">Thoughts on coding, life, and everything in between.</p>
  </section>

  <div class="tags-filter">
    <div class="tags-filter__scroll">
      <button class="tag-filter-btn active" data-tag="all">All Posts</button>
      {allTags.map(tag => (
        <button class="tag-filter-btn" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>

  <section class="posts-grid">
    {allPosts.map((post) => {
      const { title, date, description, tags = [] } = post.data;
      const readTime = getReadingTime(post.body);
      return (
        <PostCard
          title={title}
          date={date}
          description={description}
          tags={tags}
          readingTime={readTime}
          slug={post.id}
        />
      );
    })}
  </section>

  <!-- Invisible trigger element for IntersectionObserver -->
  <div id="infinite-scroll-trigger" style="height: 1px; width: 100%;"></div>

  <div id="empty-filter-state" class="empty-state" style="display: none;">
    <p>No posts found for this tag.</p>
    <button id="reset-filter-btn" class="tag-filter-btn active" style="margin-top: 1rem;">Show all posts</button>
  </div>

  {allPosts.length === 0 && (
    <div class="empty-state">
      <p>No posts yet. Drop a <code>.md</code> or <code>.mdx</code> file into <code>src/content/posts/</code> to get started!</p>
    </div>
  )}

  <script>
    import '../scripts/post-filter';
  </script>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-top: 2rem;
  }

  .page-header__title {
    font-size: 2.75rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--color-text);
  }

  .page-header__subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Tag Filter UI */
  .tags-filter {
    margin: 1.5rem 0 3rem;
    position: relative;
  }
  
  .tags-filter::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2rem;
    background: linear-gradient(to right, transparent, var(--color-bg));
    pointer-events: none;
  }

  .tags-filter__scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    touch-action: pan-x;
  }
  
  .tags-filter__scroll::-webkit-scrollbar {
    height: 4px;
  }
  .tags-filter__scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .tags-filter__scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 4px;
  }

  .tag-filter-btn {
    background: color-mix(in srgb, var(--color-accent-2) 10%, transparent);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  @media (hover: hover) {
    .tag-filter-btn:hover {
      background: color-mix(in srgb, var(--color-accent-2) 20%, transparent);
      color: var(--color-text);
    }
  }

  .tag-filter-btn.active {
    background: var(--color-accent-2);
    border-color: var(--color-accent-2);
    color: var(--color-bg);
    font-weight: 600;
  }

  /* Filtering Animation */
  :global(.post-card) {
    transition: opacity 0.3s ease, max-height 0.4s ease, padding 0.4s ease, margin 0.4s ease, border-width 0.4s ease;
    max-height: 800px;
    opacity: 1;
    overflow: hidden;
  }

  :global(.post-card.hidden) {
    opacity: 0;
    max-height: 0;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    border-width: 0 !important;
    pointer-events: none;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    background: var(--color-bg-card);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius);
  }

  .empty-state code {
    background: var(--color-bg-code);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  @media (max-width: 768px) {
    .page-header__title {
      font-size: 2rem;
    }
  }
</style>
