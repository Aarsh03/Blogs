---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SearchComponent from '../components/Search.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))].sort();
---

<BaseLayout title="Home">
  <section class="page-header">
    <h1 class="page-header__title">Latest Posts</h1>
    <p class="page-header__subtitle">Thoughts on coding, life, and everything in between.</p>
  </section>

  <SearchComponent />

  <div class="tags-filter">
    <div class="tags-filter__scroll">
      <button class="tag-filter-btn active" data-tag="all">All Posts</button>
      {allTags.map(tag => (
        <button class="tag-filter-btn" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>

  <section class="posts-grid">
    {allPosts.map((post) => {
      const readTime = readingTime(post.body ?? '').text;
      return (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          description={post.data.description}
          tags={post.data.tags}
          readingTime={readTime}
          slug={post.id}
        />
      );
    })}
  </section>

  <div id="empty-filter-state" class="empty-state" style="display: none;">
    <p>No posts found for this tag.</p>
    <button class="tag-filter-btn active" style="margin-top: 1rem;" onclick="document.querySelector('.tag-filter-btn[data-tag=\'all\']').click()">Show all posts</button>
  </div>

  {allPosts.length === 0 && (
    <div class="empty-state">
      <p>No posts yet. Drop a <code>.md</code> or <code>.mdx</code> file into <code>src/content/posts/</code> to get started!</p>
    </div>
  )}

  <script>
    document.addEventListener('astro:page-load', () => {
      const filterBtns = document.querySelectorAll('.tag-filter-btn');
      const posts = document.querySelectorAll('.post-card');
      
      // Check URL for tag parameter
      const params = new URLSearchParams(window.location.search);
      const initialTag = params.get('tag');

      function filterPosts(selectedTag) {
        // Update active button
        filterBtns.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-tag') === selectedTag);
        });

        let visibleCount = 0;
        // Update posts visibility with animation
        posts.forEach(post => {
          const postTags = (post.getAttribute('data-tags') || '').split(',');
          if (selectedTag === 'all' || postTags.includes(selectedTag)) {
            post.classList.remove('hidden');
            visibleCount++;
          } else {
            post.classList.add('hidden');
          }
        });

        const emptyState = document.getElementById('empty-filter-state');
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      // Initialize if URL has tag
      if (initialTag) {
        const btnExists = Array.from(filterBtns).some(btn => btn.getAttribute('data-tag') === initialTag);
        if (btnExists) {
          filterPosts(initialTag);
          // Auto-scroll to tags to show we are filtering
          setTimeout(() => {
            document.querySelector('.tags-filter')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        }
      }

      // Click listeners
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-tag');
          if (tag) {
            // Update URL without reload
            const url = new URL(window.location.href);
            if (tag === 'all') {
              url.searchParams.delete('tag');
            } else {
              url.searchParams.set('tag', tag);
            }
            window.history.pushState({}, '', url);
            
            filterPosts(tag);
          }
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-top: 2rem;
  }

  .page-header__title {
    font-size: 2.75rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--color-text);
  }

  .page-header__subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: all 0.3s ease;
  }

  /* Tag Filter UI */
  .tags-filter {
    margin: 1.5rem 0 3rem;
    position: relative;
  }
  
  .tags-filter::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2rem;
    background: linear-gradient(to right, transparent, var(--color-bg));
    pointer-events: none;
  }

  .tags-filter__scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    touch-action: pan-x;
    -webkit-mask-image: linear-gradient(to right, black 90%, transparent 100%);
    mask-image: linear-gradient(to right, black 90%, transparent 100%);
  }
  
  .tags-filter__scroll::-webkit-scrollbar {
    height: 4px;
  }
  .tags-filter__scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .tags-filter__scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 4px;
  }

  .tag-filter-btn {
    background: rgba(184, 169, 212, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tag-filter-btn:hover {
    background: rgba(184, 169, 212, 0.15);
    color: var(--color-text);
  }

  .tag-filter-btn.active {
    background: var(--color-accent-2);
    border-color: var(--color-accent-2);
    color: var(--color-bg);
    font-weight: 600;
  }

  [data-theme="dark"] .tag-filter-btn.active {
    color: #1a1520; /* Ensure text is dark and readable on the bright lavender pill */
  }

  /* Filtering Animation */
  :global(.post-card) {
    transition: opacity 0.3s ease, max-height 0.4s ease, padding 0.4s ease, margin 0.4s ease, border-width 0.4s ease;
    max-height: 800px;
    opacity: 1;
    overflow: hidden;
  }

  :global(.post-card.hidden) {
    opacity: 0;
    max-height: 0;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    border-width: 0 !important;
    pointer-events: none;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .empty-state code {
    background: var(--color-bg-code);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  @media (max-width: 768px) {
    .page-header__title {
      font-size: 2rem;
    }
  }
</style>
