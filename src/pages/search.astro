---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchComponent from '../components/Search.astro';
---

<BaseLayout title="Search">
  <div class="page-header">
    <h1>Search</h1>
    <p>Find posts by title, content, or tags</p>
  </div>
  
  <noscript>
    <div class="noscript-message">
      <p>Search requires JavaScript to be enabled in your browser.</p>
    </div>
  </noscript>

  <SearchComponent />
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin: 0;
  }
  .page-header p {
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }
  .noscript-message {
    padding: 1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-align: center;
    color: var(--color-text);
    margin-bottom: 2rem;
  }
</style>
