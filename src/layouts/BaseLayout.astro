---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import SearchModal from '../components/SearchModal.astro';
import CustomThemeToolbar from '../components/CustomThemeToolbar.astro';
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/700-italic.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/700.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { SITE } from '../config';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  articleDate?: string;
  articleTags?: string[];
}
const { 
  title, 
  description = SITE.description,
  image = `${import.meta.env.BASE_URL}og-image.png`,
  ogType = 'website',
  articleDate,
  articleTags
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === 'Home' ? SITE.title : `${title} — ${SITE.title}`}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <link rel="alternate" type="application/rss+xml" href={`${import.meta.env.BASE_URL}rss.xml`} />
  <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
  
  <ClientRouter />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:image" content={imageURL} />
  {articleDate && <meta property="article:published_time" content={articleDate} />}
  {articleDate && <meta property="article:author" content={SITE.author} />}
  {articleTags && articleTags.map(tag => <meta property="article:tag" content={tag} />)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

    <!-- Prevent flash of wrong theme + inject critical icon CSS before body renders -->
  <script is:inline>
    (function() {
      var savedTheme = localStorage.getItem('theme');
      var validThemes = ['obsidian', 'serenity', 'crimson', 'rose', 'nebula', 'barbie', 'solarized-light', 'frost-blue', 'midnight-black', 'snow', 'nature', 'spring', 'custom'];
      var theme = savedTheme;
      
      var migrated = false;
      if (theme === 'dark') { theme = 'obsidian'; migrated = true; }
      if (theme === 'light') { theme = 'serenity'; migrated = true; }
      if (theme === 'rose-pine') { theme = 'rose'; migrated = true; }
      if (theme === 'lavender-dark') { theme = 'nebula'; migrated = true; }
      if (theme === 'pastel-pink') { theme = 'barbie'; migrated = true; }
      if (migrated) { try { localStorage.setItem('theme', theme); } catch(e) {} }
      
      if (!theme || validThemes.indexOf(theme) === -1) {
        theme = 'crimson';
        try { localStorage.setItem('theme', theme); } catch(e) {}
      }
      
      document.documentElement.setAttribute('data-theme', theme);
        
        if (theme === 'custom') {
          var customTheme = localStorage.getItem('customTheme');
          if (customTheme) {
            try {
              var parsed = JSON.parse(customTheme);
              var s = document.createElement('style');
              s.id = 'custom-theme-vars';
              s.textContent = '[data-theme="custom"] { ' +
                '--color-bg: ' + (parsed.bg || '#ffffff') + '; ' +
                '--color-bg-card: ' + (parsed.card || '#f8f9fa') + '; ' +
                '--color-bg-nav: ' + (parsed.bg ? parsed.bg + 'd9' : 'rgba(255,255,255,0.85)') + '; ' +
                '--color-bg-code: ' + (parsed.card || '#f1f5f9') + '; ' +
                '--color-accent-1: ' + (parsed.accent1 || '#3b82f6') + '; ' +
                '--color-accent-2: ' + (parsed.accent2 || '#2563eb') + '; ' +
                '--color-accent-3: ' + (parsed.accent1 || '#60a5fa') + '; ' +
                '--color-accent-4: ' + (parsed.accent2 || '#1d4ed8') + '; ' +
                '--color-text: ' + (parsed.text || '#0f172a') + '; ' +
                '--color-text-muted: ' + (parsed.text ? 'color-mix(in srgb, ' + parsed.text + ' 70%, transparent)' : '#64748b') + '; ' +
                '--color-text-light: ' + (parsed.text ? 'color-mix(in srgb, ' + parsed.text + ' 50%, transparent)' : '#94a3b8') + '; ' +
                '--color-border: ' + (parsed.text ? 'color-mix(in srgb, ' + parsed.text + ' 15%, transparent)' : '#e2e8f0') + '; ' +
                '--color-link: var(--color-accent-2); ' +
                '--color-code-text: var(--color-accent-1); ' +
                '--color-success: #10b981; ' +
              '}';
              document.head.appendChild(s);
            } catch(e) {}
          }
        }
      
      var darkThemes = ['obsidian', 'rose', 'nebula', 'midnight-black'];
      var isDark = darkThemes.indexOf(theme) !== -1;
      if (theme === 'custom' && customTheme) { try { var p = JSON.parse(customTheme); if (p.bg) { var r=parseInt(p.bg.slice(1,3),16), g=parseInt(p.bg.slice(3,5),16), b=parseInt(p.bg.slice(5,7),16); var luma = 0.2126 * r + 0.7152 * g + 0.0722 * b; if (luma < 128) isDark = true; } } catch(e) {} }
      document.documentElement.setAttribute('data-theme-mode', isDark ? 'dark' : 'light');

      

      var savedFont = localStorage.getItem('font') || 'serif';
      document.documentElement.setAttribute('data-font', savedFont);

      var savedLayout = localStorage.getItem('layout') || 'narrow';
      document.documentElement.setAttribute('data-layout', savedLayout);

      var savedEyeComfort = localStorage.getItem('eye-comfort') || 'off';
      document.documentElement.setAttribute('data-eye-comfort', savedEyeComfort);

      var savedEyeComfortIntensity = localStorage.getItem('eye-comfort-intensity') || '7';
      document.documentElement.style.setProperty('--eye-comfort-intensity', (parseInt(savedEyeComfortIntensity) / 100).toString());

      // On View Transition swap, re-apply theme/font/comfort attributes.
      document.addEventListener('astro:after-swap', function() {
        var t = localStorage.getItem('theme');
        var validThemes = ['obsidian', 'serenity', 'crimson', 'rose', 'nebula', 'barbie', 'solarized-light', 'frost-blue', 'midnight-black', 'snow', 'nature', 'spring', 'custom'];
        
        if (t === 'dark') t = 'obsidian';
        if (t === 'light') t = 'serenity';
        if (t === 'rose-pine') t = 'rose';
        if (t === 'lavender-dark') t = 'nebula';
        if (t === 'pastel-pink') t = 'barbie';
        
        if (!t || validThemes.indexOf(t) === -1) {
          t = 'crimson';
        }
        
        document.documentElement.setAttribute('data-theme', t);
          
          var existingCustom = document.getElementById('custom-theme-vars');
          if (existingCustom) existingCustom.remove();
          
          if (t === 'custom') {
            var customTheme = localStorage.getItem('customTheme');
            if (customTheme) {
              try {
                var parsed = JSON.parse(customTheme);
                var s = document.createElement('style');
                s.id = 'custom-theme-vars';
                s.textContent = '[data-theme="custom"] { ' +
                  '--color-bg: ' + (parsed.bg || '#ffffff') + '; ' +
                  '--color-bg-card: ' + (parsed.card || '#f8f9fa') + '; ' +
                  '--color-bg-nav: ' + (parsed.bg ? parsed.bg + 'd9' : 'rgba(255,255,255,0.85)') + '; ' +
                  '--color-bg-code: ' + (parsed.card || '#f1f5f9') + '; ' +
                  '--color-accent-1: ' + (parsed.accent1 || '#3b82f6') + '; ' +
                  '--color-accent-2: ' + (parsed.accent2 || '#2563eb') + '; ' +
                  '--color-accent-3: ' + (parsed.accent1 || '#60a5fa') + '; ' +
                  '--color-accent-4: ' + (parsed.accent2 || '#1d4ed8') + '; ' +
                  '--color-text: ' + (parsed.text || '#0f172a') + '; ' +
                  '--color-text-muted: ' + (parsed.text || '#64748b') + '; ' +
                  '--color-text-light: ' + (parsed.text || '#94a3b8') + '; ' +
                  '--color-border: ' + (parsed.card || '#e2e8f0') + '; ' +
                  '--color-link: var(--color-accent-2); ' +
                  '--color-code-text: var(--color-accent-1); ' +
                  '--color-success: #10b981; ' +
                '}';
                document.head.appendChild(s);
              } catch(e) {}
            }
          }
        

        document.documentElement.setAttribute('data-theme-mode', darkThemes.indexOf(t) !== -1 ? 'dark' : 'light');

        var f = localStorage.getItem('font') || 'serif';
        document.documentElement.setAttribute('data-font', f);

        var l = localStorage.getItem('layout') || 'narrow';
        document.documentElement.setAttribute('data-layout', l);

        var ec = localStorage.getItem('eye-comfort') || 'off';
        document.documentElement.setAttribute('data-eye-comfort', ec);
        
        var eci = localStorage.getItem('eye-comfort-intensity') || '7';
        document.documentElement.style.setProperty('--eye-comfort-intensity', (parseInt(eci) / 100).toString());
      });
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Navbar />
  <main id="main-content" class="page-content">
    <div class="container">
      <slot />
    </div>
  </main>
  <FloatingActions />
  <SearchModal />
    <CustomThemeToolbar />
  <Footer />
  <script src="../scripts/copy-code.ts"></script>
  <script src="../scripts/heading-links.ts"></script>
</body>
</html>
<style>
  .page-content {
    padding-top: var(--nav-height, 64px);
  }

.skip-link {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translate(-50%, -150%);
    background: var(--color-bg-card);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 12px 24px;
    z-index: 9999;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s;
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .skip-link:focus {
    transform: translate(-50%, 0);
  }
</style>
