---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/700-italic.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/700.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { SITE } from '../config';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  articleDate?: string;
  articleTags?: string[];
}
const { 
  title, 
  description = SITE.description,
  image = `${import.meta.env.BASE_URL}og-image.png`,
  ogType = 'website',
  articleDate,
  articleTags
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === 'Home' ? SITE.title : `${title} — ${SITE.title}`}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <link rel="alternate" type="application/rss+xml" href={`${import.meta.env.BASE_URL}rss.xml`} />
  <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
  
  <ClientRouter />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:image" content={imageURL} />
  {articleDate && <meta property="article:published_time" content={articleDate} />}
  {articleDate && <meta property="article:author" content={SITE.author} />}
  {articleTags && articleTags.map(tag => <meta property="article:tag" content={tag} />)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

    <!-- Prevent flash of wrong theme + inject critical icon CSS before body renders -->
  <script is:inline>
    (function() {
      var savedTheme = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = savedTheme || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      
      var isDark = theme === 'dark' || theme === 'dracula' || theme === 'rose-pine';

      // Inject critical CSS synchronously so icons are correct before first paint.
      // MUST be inside is:inline — regular <style> tags are bundled by Astro
      // into external .css files which load async and cause FOUC.
      var s = document.createElement('style');
      s.id = 'theme-icon-critical';
      s.textContent = isDark
        ? '.icon-sun{display:block!important}.icon-moon{display:none!important}'
        : '.icon-sun{display:none!important}.icon-moon{display:block!important}';
      document.head.appendChild(s);

      var savedFont = localStorage.getItem('font') || 'serif';
      document.documentElement.setAttribute('data-font', savedFont);

      var savedLayout = localStorage.getItem('layout') || 'narrow';
      document.documentElement.setAttribute('data-layout', savedLayout);

      var savedEyeComfort = localStorage.getItem('eye-comfort') || 'off';
      document.documentElement.setAttribute('data-eye-comfort', savedEyeComfort);

      // On View Transition swap, re-apply theme/font/comfort attributes.
      document.addEventListener('astro:after-swap', function() {
        var t = localStorage.getItem('theme');
        var pd = window.matchMedia('(prefers-color-scheme: dark)').matches;
        t = t || (pd ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);

        var f = localStorage.getItem('font') || 'serif';
        document.documentElement.setAttribute('data-font', f);

        var l = localStorage.getItem('layout') || 'narrow';
        document.documentElement.setAttribute('data-layout', l);

        var ec = localStorage.getItem('eye-comfort') || 'off';
        document.documentElement.setAttribute('data-eye-comfort', ec);
      });
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Navbar />
  <main id="main-content" class="page-content">
    <div class="container">
      <slot />
    </div>
  </main>
  <ScrollToTop />
  <SearchModal />
  <Footer />
  <script src="../scripts/copy-code.ts"></script>
  <script src="../scripts/heading-links.ts"></script>
</body>
</html>
<style>
  .page-content {
    padding-top: var(--nav-height, 64px);
  }

  .skip-link {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(-100%);
    background: var(--color-accent-2);
    color: var(--color-bg);
    padding: 8px 16px;
    z-index: 1000;
    transition: transform 0.2s ease;
    text-decoration: none;
    font-weight: 600;
    border-bottom-right-radius: var(--radius-sm);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
