---
import BaseLayout from './BaseLayout.astro';
import TagChip from '../components/TagChip.astro';
import LikeButton from '../components/LikeButton.astro';
import Comments from '../components/Comments.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  description: string;
  readingTime: string;
  slug: string;
}

const { title, date, tags, description, readingTime, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "datePublished": date.toISOString(),
  "author": {
    "@type": "Person",
    "name": SITE.author
  },
  "description": description,
  "keywords": tags
};
---
<BaseLayout 
  title={title} 
  description={description}
  ogType="article"
  articleDate={date.toISOString()}
  articleTags={tags}
>
  <article class="post-wrapper container--narrow">
    <header class="post-header">
      <div class="post-tags-top">
        {tags.map((tag) => <TagChip tag={tag} />)}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <time datetime={date.toISOString()} class="post-meta__date">{formattedDate}</time>
        <span class="post-meta__dot">·</span>
        <span class="post-meta__reading">{readingTime}</span>
      </div>
      <div class="post-header__divider"></div>
    </header>

    <div class="prose" data-pagefind-body>
      <slot />
    </div>

    <LikeButton slug={slug} />
    <Comments />
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .post-wrapper {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .post-tags-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.18;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .post-description {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    font-family: var(--font-ui);
  }

  .post-meta__dot {
    opacity: 0.4;
  }

  .post-header__divider {
    margin-top: 2rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-accent-1), var(--color-accent-2), transparent);
    opacity: 0.5;
    border-radius: 1px;
  }

  @media (max-width: 768px) {
    .post-wrapper { padding-top: 1.5rem; }
    .post-title { font-size: 1.75rem; }
  }
</style>
