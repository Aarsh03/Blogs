---
import BaseLayout from './BaseLayout.astro';
import TagChip from '../components/TagChip.astro';
import LikeButton from '../components/LikeButton.astro';
import Comments from '../components/Comments.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ViewCounter from '../components/ViewCounter.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SeriesBox from '../components/SeriesBox.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { SITE } from '../config';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  description: string;
  readingTime: string;
  slug: string;
  prevPost?: CollectionEntry<'posts'> | null;
  nextPost?: CollectionEntry<'posts'> | null;
  headings?: MarkdownHeading[];
  series?: string;
}

const { title, date, tags, description, readingTime, slug, prevPost, nextPost, headings = [], series } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "datePublished": date.toISOString(),
  "author": {
    "@type": "Person",
    "name": SITE.author
  },
  "description": description,
  "keywords": tags
};
---
<BaseLayout 
  title={title} 
  description={description}
  ogType="article"
  articleDate={date.toISOString()}
  articleTags={tags}
  image={`${import.meta.env.BASE_URL}open-graph/${slug}.png`}
>
  <ReadingProgress />
  <article class="post-wrapper container--narrow">
    <header class="post-header">
      <div class="post-tags-top">
        {tags.map((tag) => <TagChip tag={tag} />)}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <time datetime={date.toISOString()} class="post-meta__date">{formattedDate}</time>
        <span class="post-meta__dot">·</span>
        <span class="post-meta__reading">{readingTime}</span>
        <span class="post-meta__dot">·</span>
        <ViewCounter slug={slug} />
      </div>
      <div class="post-header__divider"></div>
    </header>

    {series && <SeriesBox seriesName={series} currentSlug={slug} />}

    <TableOfContents headings={headings} />

    <div class="prose" data-pagefind-body>
      <slot />
    </div>

    <LikeButton slug={slug} title={title} />
    
    <AuthorBio />
    
    { (prevPost || nextPost) && (
      <div class="post-nav">
        {prevPost ? (
          <a href={`${import.meta.env.BASE_URL}blog/${prevPost.id}/`} class="post-nav-card prev">
            <span class="post-nav-label">← Previous Post</span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </a>
        ) : <div class="post-nav-empty"></div>}
        
        {nextPost ? (
          <a href={`${import.meta.env.BASE_URL}blog/${nextPost.id}/`} class="post-nav-card next">
            <span class="post-nav-label">Next Post →</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        ) : <div class="post-nav-empty"></div>}
      </div>
    )}

    <RelatedPosts currentSlug={slug} currentTags={tags} />

    <Comments />
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script>
    import mediumZoom from 'medium-zoom';
    
    // Track zoom instance at module level for cleanup
    let _zoomInstance: ReturnType<typeof mediumZoom> | null = null;

    document.addEventListener('astro:page-load', () => {
      // Detach previous zoom instance
      _zoomInstance?.detach();
      
      _zoomInstance = mediumZoom('.prose img', {
        margin: 24,
        background: 'var(--color-bg)',
      });
    });
  </script>
</BaseLayout>

<style>
  .post-wrapper {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .post-tags-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.18;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .post-description {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    font-family: var(--font-ui);
  }

  .post-meta__dot {
    opacity: 0.4;
  }

  .post-header__divider {
    margin-top: 2rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-accent-1), var(--color-accent-2), transparent);
    opacity: 0.5;
    border-radius: 1px;
  }

  /* ─── Post Navigation ─── */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 3rem 0;
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-nav-card:hover {
    border-color: var(--color-accent-2);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .post-nav-card.next {
    align-items: flex-end;
    text-align: right;
  }

  .post-nav-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-nav-title {
    font-size: 1.1rem;
    font-family: var(--font-heading);
    color: var(--color-text);
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .post-nav-card:hover .post-nav-title {
    color: var(--color-accent-2);
  }

  .post-nav-empty {
    visibility: hidden;
  }

  @media (max-width: 768px) {
    .post-wrapper { padding-top: 1.5rem; }
    .post-title { font-size: 1.75rem; }
    .post-nav {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .post-nav-card.next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
