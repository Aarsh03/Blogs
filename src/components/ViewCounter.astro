---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
<span class="view-counter" data-slug={slug}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span class="view-count">—</span>
</span>

<script>
  import { SITE } from '../config';
  const LIKES_API_URL = SITE.likesApiUrl;

  document.addEventListener('astro:page-load', () => {
    const counters = document.querySelectorAll('.view-counter');
    counters.forEach(async (el) => {
      const slug = (el as HTMLElement).dataset.slug;
      const countSpan = el.querySelector('.view-count');
      if (!slug || !countSpan) return;
      
      const hasViewed = sessionStorage.getItem(`viewed-${slug}`);
      
      try {
        if (!hasViewed) {
          sessionStorage.setItem(`viewed-${slug}`, 'true');
          const res = await fetch(`${LIKES_API_URL}/views/${slug}`, { method: 'POST' });
          if (res.ok) {
            const data = await res.json();
            countSpan.textContent = data.count + ' views';
          }
        } else {
          const res = await fetch(`${LIKES_API_URL}/views/${slug}`);
          if (res.ok) {
            const data = await res.json();
            countSpan.textContent = data.count + ' views';
          }
        }
      } catch (e) {
        console.error('Error fetching views', e);
      }
    });
  });
</script>

<style>
  .view-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .view-counter svg {
    opacity: 0.7;
  }
</style>
