---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;
---

<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search posts">
  <div class="search-modal__backdrop" id="search-modal-backdrop"></div>
  <div class="search-modal__content">
    <div class="search-modal__header">
      <span class="search-modal__title">Search Posts</span>
      <button class="search-modal__close" id="search-modal-close" aria-label="Close search">
        <Icon name="close" />
      </button>
    </div>
    
    <div id="search" class="search-container" data-base={base}></div>
    
    <div class="search-modal__footer">
      <div class="search-modal__keyhint"><kbd>Esc</kbd> to close</div>
      <div class="search-modal__keyhint"><kbd>↑</kbd> <kbd>↓</kbd> to navigate</div>
      <div class="search-modal__keyhint"><kbd>Enter</kbd> to select</div>
      <div class="search-modal__keyhint search-modal__keyhint--right">
        Try <kbd>&gt;dark</kbd> or <kbd>&gt;theme snow</kbd>
      </div>
    </div>
  </div>
</div>

<link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
<script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>

<script>
  let _keydownListener: ((e: KeyboardEvent) => void) | null = null;
  declare var PagefindUI: any;

  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('search-modal');
    const backdrop = document.getElementById('search-modal-backdrop');
    const closeBtn = document.getElementById('search-modal-close');
    const openBtn = document.getElementById('search-modal-btn');
    const searchDiv = document.getElementById('search');
    
    if (!modal || !searchDiv) return;

    // Initialize Pagefind on every page-load for ViewTransitions
    // @ts-ignore
    if (typeof PagefindUI !== 'undefined') {
      try {
        searchDiv.innerHTML = '';
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          resetStyles: false,
          showImages: false,
          bundlePath: `${import.meta.env.BASE_URL}pagefind/`
        });
        
        // Setup Command Interceptor safely with MutationObserver to avoid race conditions
        const observer = new MutationObserver((mutations, obs) => {
          const input = searchDiv.querySelector('.pagefind-ui__search-input');
          if (input) {
            input.addEventListener('input', (e) => {
              const val = (e.target as HTMLInputElement).value.trim().toLowerCase();
              if (val.startsWith('>')) {
                const cmd = val.substring(1);
                
                const darkThemes = ['obsidian', 'rose', 'nebula', 'midnight-black'];
                function applyCommandTheme(t: string) {
                  document.documentElement.setAttribute('data-theme', t);
                  document.documentElement.setAttribute('data-theme-mode', darkThemes.includes(t) ? 'dark' : 'light');
                  localStorage.setItem('theme', t);
                  // Update swatches visually if they exist
                  document.querySelectorAll('.theme-swatch').forEach(swatch => {
                    swatch.classList.toggle('active', swatch.getAttribute('data-theme-val') === t);
                  });
                }

                if (cmd === 'dark') applyCommandTheme('obsidian');
                if (cmd === 'light') applyCommandTheme('serenity');
                
                const themes = ['obsidian', 'serenity', 'crimson', 'rose', 'nebula', 'barbie', 'solarized-light', 'frost-blue', 'midnight-black', 'snow', 'nature', 'spring', 'custom'];
                if (cmd.startsWith('theme ')) {
                  const targetTheme = cmd.split(' ')[1];
                  if (themes.includes(targetTheme)) applyCommandTheme(targetTheme);
                }
                
                const base = document.getElementById('search')?.getAttribute('data-base') || '/';
                if (cmd === 'home') window.location.href = base;
                if (cmd === 'about') window.location.href = base + (base.endsWith('/') ? 'about' : '/about');
              }
            });
            obs.disconnect(); // Stop observing once found
          }
        });
        observer.observe(searchDiv, { childList: true, subtree: true });
        
      } catch (e) {
        console.error("Pagefind error", e);
      }
    }

    function openModal() {
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Focus the input, wait for it to render if necessary
      const focusInput = () => {
        const input = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement | null;
        if (input) {
          input.focus();
        } else {
          requestAnimationFrame(focusInput);
        }
      };
      requestAnimationFrame(focusInput);
    }

    function closeModal() {
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Toggle logic
    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    if (_keydownListener) {
      document.removeEventListener('keydown', _keydownListener);
    }

    _keydownListener = (e: KeyboardEvent) => {
      // Cmd+K or Ctrl+K to open
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const isOpen = modal.getAttribute('aria-hidden') === 'false';
        if (isOpen) {
          closeModal();
        } else {
          openModal();
        }
      }
      
      // Esc to close
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }

      // Arrow up/down and Enter navigation for results
      if (modal.getAttribute('aria-hidden') === 'false') {
        const active = document.activeElement as HTMLElement | null;

        if (e.key === 'Enter') {
          if (active && active.classList.contains('pagefind-ui__search-input')) {
            e.preventDefault();
            const firstResult = modal.querySelector('.pagefind-ui__result-link') as HTMLElement;
            if (firstResult) {
              firstResult.click();
            }
          }
        }

        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const focusable = Array.from(modal.querySelectorAll('.pagefind-ui__search-input, .pagefind-ui__result-link, .pagefind-ui__search-clear')) as HTMLElement[];
          let index = active ? focusable.indexOf(active) : -1;
          
          if (e.key === 'ArrowDown') {
            index = index + 1 < focusable.length ? index + 1 : 0;
          } else {
            index = index - 1 >= 0 ? index - 1 : focusable.length - 1;
          }
          
          if (focusable[index]) {
            focusable[index].focus();
          }
        }
      }

      // Focus trap
      if (modal.getAttribute('aria-hidden') === 'false' && e.key === 'Tab') {
        const focusable = Array.from(modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')) as HTMLElement[];
        if (focusable.length) {
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            last.focus();
            e.preventDefault();
          } else if (!e.shiftKey && document.activeElement === last) {
            first.focus();
            e.preventDefault();
          }
        }
      }
    };
    document.addEventListener('keydown', _keydownListener);
  });

  document.addEventListener('astro:before-swap', () => {
    if (_keydownListener) {
      document.removeEventListener('keydown', _keydownListener);
      _keydownListener = null;
    }
  });
</script>

<style is:global>
  /* ── Modal overlay ── */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 10vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .search-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  /* ── Backdrop: full-screen blur of the actual page ── */
  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-bg-nav);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.35s ease;
  }

  /* ── Glass panel: transparent card on top of blurred backdrop ──
     overflow:hidden is safe here because backdrop-filter is on the backdrop,
     not on this element — no browser conflict. ── */
  .search-modal__content {
    position: relative;
    width: 90%;
    max-width: 650px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card-hover);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    transform: translateY(-24px) scale(0.96);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .search-modal[aria-hidden="false"] .search-modal__content {
    transform: translateY(0) scale(1);
  }

  /* ── Header ── */
  .search-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .search-modal__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .search-modal__close {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  @media (hover: hover) {
    .search-modal__close:hover {
      background: color-mix(in srgb, var(--color-accent-2) 20%, transparent);
      color: var(--color-accent-2);
    }
  }

  /* ── Search container ── */
  .search-container {
    width: 100%;
    padding: 1rem 1.5rem;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* ── Footer ── */
  .search-modal__footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background: transparent;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .search-modal__keyhint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .search-modal__keyhint--right {
    margin-left: auto;
  }

  .search-modal__keyhint kbd {
    background: var(--color-bg-code);
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0.1rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .search-modal { padding-top: 5vh; }
    .search-modal__content { width: 95%; max-height: 90vh; }
    .search-modal__footer { padding: 0.65rem 1rem; gap: 0.4rem; justify-content: center; flex-wrap: wrap; }
    .search-modal__keyhint--right { margin-left: 0; }
  }
</style>
