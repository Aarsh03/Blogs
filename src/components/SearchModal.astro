---
const base = import.meta.env.BASE_URL;
---

<div id="search-modal" class="search-modal" aria-hidden="true">
  <div class="search-modal__backdrop" id="search-modal-backdrop"></div>
  <div class="search-modal__content">
    <div class="search-modal__header">
      <span class="search-modal__title">Search Posts</span>
      <button class="search-modal__close" id="search-modal-close" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <div id="search" class="search-container" data-base={base}></div>
    
    <div class="search-modal__footer">
      <div class="search-modal__keyhint"><kbd>Esc</kbd> to close</div>
      <div class="search-modal__keyhint"><kbd>↑</kbd> <kbd>↓</kbd> to navigate</div>
      <div class="search-modal__keyhint"><kbd>Enter</kbd> to select</div>
    </div>
  </div>
</div>

<link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
<script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>

<script>
  let _keydownListener = null;

  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('search-modal');
    const backdrop = document.getElementById('search-modal-backdrop');
    const closeBtn = document.getElementById('search-modal-close');
    const openBtn = document.getElementById('search-modal-btn');
    const searchDiv = document.getElementById('search');
    
    if (!modal || !searchDiv) return;

    // Initialize Pagefind on every page-load for ViewTransitions
    // @ts-ignore
    if (typeof PagefindUI !== 'undefined') {
      try {
        searchDiv.innerHTML = '';
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          resetStyles: false,
          showImages: false,
          bundlePath: `${import.meta.env.BASE_URL}pagefind/`
        });
      } catch (e) {
        console.error("Pagefind error", e);
      }
    }

    function openModal() {
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Focus the input inside the shadow DOM if possible, or wait a tick
      setTimeout(() => {
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      }, 100);
    }

    function closeModal() {
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Toggle logic
    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    if (_keydownListener) {
      document.removeEventListener('keydown', _keydownListener);
    }

    _keydownListener = (e) => {
      // Cmd+K or Ctrl+K to open
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const isOpen = modal.getAttribute('aria-hidden') === 'false';
        if (isOpen) {
          closeModal();
        } else {
          openModal();
        }
      }
      
      // Esc to close
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }

      // Arrow up/down and Enter navigation for results
      if (modal.getAttribute('aria-hidden') === 'false') {
        const active = document.activeElement;

        if (e.key === 'Enter') {
          if (active && active.classList.contains('pagefind-ui__search-input')) {
            e.preventDefault();
            const firstResult = modal.querySelector('.pagefind-ui__result-link');
            if (firstResult) {
              firstResult.click();
            }
          }
        }

        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const focusable = Array.from(modal.querySelectorAll('.pagefind-ui__search-input, .pagefind-ui__result-link, .pagefind-ui__search-clear'));
          let index = focusable.indexOf(active);
          
          if (e.key === 'ArrowDown') {
            index = index + 1 < focusable.length ? index + 1 : 0;
          } else {
            index = index - 1 >= 0 ? index - 1 : focusable.length - 1;
          }
          
          if (focusable[index]) {
            focusable[index].focus();
          }
        }
      }
    };
    document.addEventListener('keydown', _keydownListener);
  });

  document.addEventListener('astro:before-swap', () => {
    if (_keydownListener) {
      document.removeEventListener('keydown', _keydownListener);
      _keydownListener = null;
    }
  });
</script>

<style is:global>
  /* ── Modal overlay ── */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 10vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .search-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  /* ── Backdrop: full-screen blur of the actual page ── */
  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    /* Blur the real page content, not a grey overlay */
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    background: rgba(253, 246, 249, 0.25);
    transition: background 0.35s ease;
  }

  [data-theme="dark"] .search-modal__backdrop {
    background: rgba(15, 10, 22, 0.45);
  }

  /* ── Glass panel: transparent card on top of blurred backdrop ──
     overflow:hidden is safe here because backdrop-filter is on the backdrop,
     not on this element — no browser conflict. ── */
  .search-modal__content {
    position: relative;
    width: 90%;
    max-width: 650px;
    /* Light glass: warm white tint, clearly readable */
    background: rgba(255, 252, 254, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-bottom-color: rgba(200, 190, 210, 0.3);
    border-right-color: rgba(200, 190, 210, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 24px 64px rgba(0, 0, 0, 0.14);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    transform: translateY(-24px) scale(0.96);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  [data-theme="dark"] .search-modal__content {
    /* Dark glass: deep purple tint, legible on dark backgrounds */
    background: rgba(30, 23, 42, 0.82);
    border-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.04);
    border-right-color: rgba(255, 255, 255, 0.04);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 24px 64px rgba(0, 0, 0, 0.55);
  }

  .search-modal[aria-hidden="false"] .search-modal__content {
    transform: translateY(0) scale(1);
  }

  /* ── Header ── */
  .search-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(184, 169, 212, 0.25);
    flex-shrink: 0;
  }

  [data-theme="dark"] .search-modal__header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .search-modal__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .search-modal__close {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  @media (hover: hover) {
    .search-modal__close:hover {
      background: rgba(184, 169, 212, 0.2);
      color: var(--color-accent-2);
    }
  }

  /* ── Search container ── */
  .search-container {
    width: 100%;
    padding: 1rem 1.5rem;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* ── Footer ── */
  .search-modal__footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 1.5rem;
    border-top: 1px solid rgba(184, 169, 212, 0.25);
    background: transparent;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  [data-theme="dark"] .search-modal__footer {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .search-modal__keyhint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .search-modal__keyhint kbd {
    background: rgba(184, 169, 212, 0.15);
    border: 1px solid rgba(184, 169, 212, 0.3);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0.1rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text);
  }

  [data-theme="dark"] .search-modal__keyhint kbd {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .search-modal { padding-top: 5vh; }
    .search-modal__content { width: 95%; max-height: 90vh; }
    .search-modal__footer { padding: 0.65rem 1rem; gap: 0.4rem; justify-content: center; }
  }

  /* ── Pagefind UI overrides ── */
  :root {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent-2);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-font: var(--font-ui);
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-background: transparent;
  }

  /* Search input — clearly visible on the glass panel */
  .pagefind-ui__search-input {
    background: rgba(255, 255, 255, 0.6) !important;
    border: 1.5px solid rgba(184, 169, 212, 0.45) !important;
    border-radius: 999px !important;
    color: #1a1520 !important;
    font-weight: 500 !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease !important;
  }

  [data-theme="dark"] .pagefind-ui__search-input {
    background: rgba(255, 255, 255, 0.1) !important;
    border-color: rgba(196, 181, 232, 0.3) !important;
    color: #f0eaf4 !important;
  }

  .pagefind-ui__search-input:focus {
    border-color: var(--color-accent-2) !important;
    background: rgba(255, 255, 255, 0.92) !important;
    box-shadow: 0 0 0 4px rgba(184, 169, 212, 0.25) !important;
    outline: none !important;
  }

  [data-theme="dark"] .pagefind-ui__search-input:focus {
    background: rgba(255, 255, 255, 0.15) !important;
    box-shadow: 0 0 0 4px rgba(196, 181, 232, 0.2) !important;
  }

  .pagefind-ui__search-clear {
    color: var(--color-text-muted) !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 999px !important;
    padding: 0 1rem !important;
    outline: none !important;
  }

  @media (hover: hover) {
    .pagefind-ui__search-clear:hover { color: var(--color-accent-2) !important; }
    .pagefind-ui__result-link:hover  { color: var(--color-accent-2) !important; }
  }

  /* Result text — force all Pagefind text to respect theme in dark mode */
  .pagefind-ui__result-link {
    color: var(--color-text) !important;
    text-decoration: none !important;
    font-weight: 600 !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--color-text-muted) !important;
  }

  [data-theme="dark"] .pagefind-ui__result-excerpt {
    color: #a89db8 !important;
  }

  /* Force ALL text nodes inside pagefind results to respect dark theme */
  [data-theme="dark"] .pagefind-ui__result-link,
  [data-theme="dark"] .pagefind-ui__result-title,
  [data-theme="dark"] .pagefind-ui__message {
    color: #f0eaf4 !important;
  }

  .pagefind-ui__result-excerpt mark {
    background-color: rgba(232, 180, 203, 0.3) !important;
    color: var(--color-text) !important;
    padding: 0.1em 0.3em !important;
    border-radius: 4px !important;
  }

  [data-theme="dark"] .pagefind-ui__result-excerpt mark {
    background-color: rgba(232, 160, 191, 0.25) !important;
    color: #f0eaf4 !important;
  }

  .pagefind-ui__result {
    padding: 1rem 0 !important;
    border-bottom: 1px solid rgba(184, 169, 212, 0.2) !important;
  }

  [data-theme="dark"] .pagefind-ui__result {
    border-bottom-color: rgba(255, 255, 255, 0.07) !important;
  }

  .pagefind-ui__result:last-child { border-bottom: none !important; }

  /* Message text (e.g. "X results for...") */
  .pagefind-ui__message {
    color: var(--color-text-muted) !important;
  }
</style>
