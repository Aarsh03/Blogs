---
import TagChip from './TagChip.astro';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  readingTime: string;
  slug: string;
}
const { title, date, description, tags, readingTime, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<a href={`${base}blog/${slug}`} class="card post-card">
  <h2 class="post-card__title">{title}</h2>
  <div class="post-meta">
    <span>{formattedDate}</span> &middot; <span>{readingTime}</span>
  </div>
  <p class="post-card__description">{description}</p>
  <div class="post-card__tags">
    {tags.map((tag) => (
      <TagChip tag={tag} linked={false} />
    ))}
  </div>
</a>
<style>
  .post-card {
    text-decoration: none;
    color: inherit;
    display: block;
    margin-bottom: 1.5rem;
  }
  .post-card__title {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
    color: var(--color-text);
    margin-top: 0;
  }
  .post-card:hover .post-card__title {
    color: var(--color-accent-2);
  }
  .post-meta {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .post-card__description {
    color: var(--color-text-muted);
    margin: 0.75rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }
</style>
