---
import TagChip from './TagChip.astro';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  readingTime: string;
  slug: string;
}
const { title, date, description, tags, readingTime, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<a href={`${base}blog/${slug}`} class="card post-card">
  <div class="post-card__tags">
    {tags.map((tag) => (
      <TagChip tag={tag} linked={false} />
    ))}
  </div>
  <h2 class="post-card__title">{title}</h2>
  <p class="post-card__description">{description}</p>
  <div class="post-card__meta">
    <span class="post-card__date">{formattedDate}</span>
    <span class="post-card__dot">·</span>
    <span class="post-card__reading">{readingTime}</span>
    <span class="post-card__arrow">→</span>
  </div>
</a>

<style>
  .post-card {
    text-decoration: none;
    color: inherit;
    display: block;
    margin-bottom: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(232,180,203,0.07), rgba(184,169,212,0.07));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-card:hover {
    text-decoration: none;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
  }

  .post-card__title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.6rem;
    line-height: 1.3;
    transition: color 0.2s ease;
    letter-spacing: -0.01em;
  }

  .post-card:hover .post-card__title {
    color: var(--color-accent-2);
  }

  .post-card__description {
    font-family: var(--font-ui);
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-light);
    font-family: var(--font-ui);
  }

  .post-card__dot {
    opacity: 0.4;
  }

  .post-card__arrow {
    margin-left: auto;
    color: var(--color-accent-2);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    font-size: 1rem;
  }

  .post-card:hover .post-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
