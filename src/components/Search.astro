---
const base = import.meta.env.BASE_URL;
---
<link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
<script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>

<div id="search" class="search-container"></div>

<script is:inline define:vars={{ base }}>
  document.addEventListener('astro:page-load', () => {
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      baseUrl: base
    });
  });
</script>
<style is:global>
  .search-container {
    width: 100%;
    max-width: 600px; /* Make it less heavy */
    margin: 0 auto 3rem auto;
  }

  /* Core UI Overrides */
  :root {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--color-accent-2);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-font: var(--font-ui);
    --pagefind-ui-border-radius: 999px;
  }

  /* The actual input container */
  .pagefind-ui__search-input {
    background: rgba(255, 255, 255, 0.55) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 999px !important;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02) !important;
    font-weight: 500 !important;
    transition: all 0.3s ease !important;
  }

  /* Dark mode input */
  :root[data-theme="dark"] .pagefind-ui__search-input {
    background: rgba(196, 181, 232, 0.08) !important;
    border-color: rgba(196, 181, 232, 0.2) !important;
  }

  .pagefind-ui__search-input:focus-within {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08) !important;
    border-color: var(--color-accent-2) !important;
    background: var(--color-bg-card) !important;
  }

  /* Input text field */
  .pagefind-ui__search-input input {
    font-weight: 500 !important;
    color: var(--color-text) !important;
    background: transparent !important;
  }

  /* Clear button */
  .pagefind-ui__search-clear {
    border-radius: 999px !important;
    background-color: transparent !important;
  }
  
  /* Results area */
  .pagefind-ui__result-link {
    color: var(--color-accent-2) !important;
  }
  
  .pagefind-ui__result-excerpt mark {
    background-color: rgba(232, 180, 203, 0.3) !important;
    color: var(--color-text) !important;
    padding: 0 0.2em !important;
    border-radius: 4px !important;
  }
</style>
