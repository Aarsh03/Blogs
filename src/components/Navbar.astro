---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Home', href: base },
  { label: 'Tags', href: `${base}tags` },
  { label: 'Search', href: `${base}search` },
  { label: 'About', href: `${base}about` }
];

function isActive(linkHref: string) {
  if (linkHref === base) {
    return pathname === base || pathname === base.slice(0, -1);
  }
  return pathname.startsWith(linkHref);
}
---
<nav class="navbar">
  <div class="navbar__inner">
    <a class="navbar__logo" href={base}>
      <span class="logo-text">Aarsh's blogs</span>
    </a>

    <ul class="navbar__links">
      {links.map(link => (
        <li>
          <a
            class:list={['navbar__link', { active: isActive(link.href) }]}
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="navbar__actions">
      <!-- Theme toggle -->
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Hamburger -->
      <button class="hamburger" id="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-overlay" id="mobile-overlay"></div>
<div class="mobile-menu" id="mobile-menu">
  <ul class="mobile-links">
    {links.map(link => (
      <li>
        <a
          class:list={['mobile-link', { active: isActive(link.href) }]}
          href={link.href}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  /* ── Mobile menu ── */
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');

  function toggleMenu() {
    const isOpen = menu?.classList.toggle('open');
    overlay?.classList.toggle('open');
    btn?.classList.toggle('open');
    btn?.setAttribute('aria-expanded', String(isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  btn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);

  /* ── Theme toggle ── */
  const toggleBtn = document.getElementById('theme-toggle');
  const html = document.documentElement;

  function applyTheme(theme) {
    html.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    // Update icon: show sun when dark (to switch to light), moon when light (to switch to dark)
    const sunIcon = toggleBtn?.querySelector('.icon-sun');
    const moonIcon = toggleBtn?.querySelector('.icon-moon');
    if (theme === 'dark') {
      sunIcon?.removeAttribute('hidden');
      moonIcon?.setAttribute('hidden', '');
    } else {
      sunIcon?.setAttribute('hidden', '');
      moonIcon?.removeAttribute('hidden');
    }
  }

  // Sync icon on initial load
  const initialTheme = html.getAttribute('data-theme') || 'light';
  applyTheme(initialTheme);

  toggleBtn?.addEventListener('click', () => {
    const isDark = html.getAttribute('data-theme') === 'dark';
    applyTheme(isDark ? 'light' : 'dark');
  });
</script>

<style>
  /* ─── Navbar Container ─── */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height, 64px);
    z-index: 200;
    background: var(--color-bg-nav);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: var(--max-width-wide, 960px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ─── Logo ─── */
  .navbar__logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .navbar__logo:hover .logo-text {
    color: var(--color-accent-2);
    text-decoration: none;
  }

  /* ─── Desktop Links ─── */
  .navbar__links {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  /* Dark mode: pill needs a visible tinted bg, not transparent */
  [data-theme="dark"] .navbar__links {
    background: rgba(196, 181, 232, 0.12);
    border-color: rgba(196, 181, 232, 0.25);
  }

  .navbar__link {
    display: block;
    text-decoration: none;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  /* Dark mode: muted text is too dark on dark bg, brighten it */
  [data-theme="dark"] .navbar__link {
    color: rgba(240, 234, 244, 0.65);
  }

  .navbar__link:hover {
    color: var(--color-text);
    background: var(--color-bg-card);
    text-decoration: none;
  }

  .navbar__link.active {
    color: var(--color-accent-2);
    background: var(--color-bg-card);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  /* ─── Actions (theme toggle + hamburger) ─── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* ─── Theme Toggle ─── */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: all 0.25s ease;
    padding: 0;
  }

  .theme-toggle:hover {
    background: var(--color-bg-card);
    color: var(--color-accent-2);
    border-color: var(--color-accent-2);
    transform: rotate(20deg);
  }

  /* Both icons visible by default; JS immediately hides the right one on load.
     Using opacity+width trick so layout doesn't shift before JS runs. */
  .icon-moon { display: block; }
  .icon-sun  { display: block; }
  .icon-moon[hidden] { display: none !important; }
  .icon-sun[hidden]  { display: none !important; }

  /* ─── Hamburger ─── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    z-index: 201;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .hamburger:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  [data-theme="dark"] .hamburger:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background: var(--color-text-muted);
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .hamburger.open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile Overlay ─── */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(4px);
    z-index: 190;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-overlay.open {
    display: block;
    opacity: 1;
  }

  /* ─── Mobile Menu ─── */
  .mobile-menu {
    position: fixed;
    top: var(--nav-height, 64px);
    left: 0;
    right: 0;
    background: var(--color-bg-nav);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    z-index: 195;
    padding: 0.75rem 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    transform: translateY(-16px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.3s;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .mobile-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-link {
    display: block;
    text-decoration: none;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm, 8px);
    transition: all 0.2s ease;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-accent-2);
    background: var(--color-bg-card);
    text-decoration: none;
  }

  .mobile-link.active {
    font-weight: 600;
  }

  /* ─── Responsive ─── */
  @media (min-width: 769px) {
    .hamburger { display: none; }
    .mobile-menu { display: none !important; }
    .mobile-overlay { display: none !important; }
  }

  @media (max-width: 768px) {
    .navbar__links { display: none; }
    .hamburger { display: flex; }

    .logo-text { font-size: 1.1rem; }
  }
</style>
