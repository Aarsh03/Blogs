---
import SettingsPanel from './navbar/SettingsPanel.astro';
import MobileMenu from './navbar/MobileMenu.astro';
import '../styles/navbar.css';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Home', href: base },
  { label: 'About', href: `${base}about` }
];

function isActive(linkHref: string) {
  if (linkHref === base) {
    return pathname === base || pathname === base.slice(0, -1);
  }
  return pathname.startsWith(linkHref);
}
---
<nav class="navbar">
  <div class="navbar__inner">
    <a class="navbar__logo" href={base} aria-label="Aarsh's blogs home">
      <div class="logo-monogram">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
          <!-- A -->
          <path d="M45 20 L25 80 M45 20 L65 80 M15 60 L53 60" />
          <!-- S sweeping under -->
          <path d="M45 20 C65 10, 80 25, 60 50 C40 70, 85 60, 85 80 C85 105, 45 105, 30 90 C20 80, 20 65, 25 60" />
        </svg>
      </div>
    </a>

    <ul class="navbar__links">
      {links.map(link => (
        <li>
          <a
            class:list={['navbar__link', { active: isActive(link.href) }]}
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="navbar__actions">
      <!-- Search Modal Toggle (Search Pill) -->
      <button class="search-toggle search-pill" id="search-modal-btn" aria-label="Search (Ctrl+K)">
        <span class="search-pill-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </span>
        <span class="search-pill-text">Search...</span>
        <kbd class="search-pill-kbd">⌘K</kbd>
      </button>



      <SettingsPanel />

      <!-- Hamburger -->
      <button class="hamburger" id="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>

<MobileMenu links={links} isActive={isActive} />

<script>
  import '../scripts/navbar';
</script>
