---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// Filter to h2 and h3 only
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <details class="toc-container">
    <summary class="toc-summary">
      <span class="toc-title">Table of Contents</span>
      <svg class="toc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <div class="toc-content">
      <ul class="toc-list">
        {toc.map((heading) => (
          <li class={`toc-item toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </details>
)}

<style>
  .toc-container {
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 16px;
    margin: 2.5rem 0;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :global([data-theme-mode="dark"]) .toc-container {
    background: rgba(35, 29, 44, 0.4);
    border: 1px solid rgba(196, 181, 232, 0.12);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .toc-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    user-select: none;
    transition: background 0.2s ease;
  }

  .toc-summary:hover {
    background: rgba(184, 169, 212, 0.08);
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--color-accent-2);
  }

  details[open] .toc-icon {
    transform: rotate(180deg);
  }

  .toc-content {
    padding: 0 1.5rem 1.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-left: 1px solid rgba(184, 169, 212, 0.3);
  }

  .toc-item a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    display: inline-block;
    padding-left: 1rem;
    position: relative;
  }

  .toc-item a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    height: 100%;
    width: 2px;
    background: var(--color-accent-2);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease;
  }

  .toc-item a:hover,
  .toc-item a.active-toc {
    color: var(--color-text);
    transform: translateX(4px);
    font-weight: 600;
  }

  .toc-item a:hover::before,
  .toc-item a.active-toc::before {
    transform: scaleY(1);
  }

  .toc-depth-3 {
    padding-left: 1rem;
    font-size: 0.88rem;
  }
</style>

<script>
  let _tocObserver = null;

  document.addEventListener('astro:page-load', () => {
    if (_tocObserver) {
      _tocObserver.disconnect();
    }

    const tocLinks = document.querySelectorAll('.toc-item a');
    if (tocLinks.length === 0) return;

    const headings = Array.from(document.querySelectorAll('.prose h2, .prose h3, .prose h4'));
    
    // Intersection observer to track active heading
    _tocObserver = new IntersectionObserver((entries) => {
      // Find the first intersecting heading
      const intersecting = entries.find(entry => entry.isIntersecting);
      
      if (intersecting) {
        const id = intersecting.target.id;
        
        tocLinks.forEach(link => link.classList.remove('active-toc'));
        
        const activeLink = document.querySelector(`.toc-item a[href="#${id}"]`);
        if (activeLink) {
          activeLink.classList.add('active-toc');
        }
      }
    }, {
      rootMargin: '-80px 0px -70% 0px',
      threshold: 0
    });

    headings.forEach(heading => _tocObserver.observe(heading));
  });

  document.addEventListener('astro:before-swap', () => {
    if (_tocObserver) {
      _tocObserver.disconnect();
      _tocObserver = null;
    }
  });
</script>
