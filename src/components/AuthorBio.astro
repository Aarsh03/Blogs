---
import { SITE } from '../config';

const author = SITE.author;
const description = SITE.description;
const email = SITE.email;
const social = SITE.social;
---
<div class="author-bio">
  <div class="author-bio__avatar">
    <div class="author-bio__avatar-initial">{author.charAt(0)}</div>
  </div>
  <div class="author-bio__info">
    <h3 class="author-bio__name">{author}</h3>
    <p class="author-bio__desc">{description}</p>
    <div class="author-bio__links">
      {social.github && (
        <a href={social.github} target="_blank" rel="noopener noreferrer" class="author-bio__link" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
      )}
      {social.linkedin && (
        <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="author-bio__link" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      )}
      {email && (
        <a href={`mailto:${email}`} class="author-bio__link" aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .author-bio {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin: 4rem 0 2rem;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  @media (hover: hover) {
    .author-bio:hover {
      box-shadow: var(--shadow-card-hover);
      border-color: var(--color-accent-2);
    }
  }

  .author-bio__avatar {
    flex-shrink: 0;
  }

  .author-bio__avatar-initial {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-1), var(--color-accent-2), var(--color-accent-1));
    background-size: 200% 100%;
    animation: flowGradient 3s linear infinite;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-bg);
    font-family: var(--font-heading);
    box-shadow: var(--shadow-card);
  }

  [data-theme-mode="dark"] .author-bio__avatar-initial {
    box-shadow: var(--shadow-card-hover);
  }

  .author-bio__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .author-bio__name {
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .author-bio__desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .author-bio__links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .author-bio__link {
    color: var(--color-text-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (hover: hover) {
    .author-bio__link:hover {
      color: var(--color-accent-2);
      transform: translateY(-2px) scale(1.1);
    }
  }

  @media (max-width: 600px) {
    .author-bio {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
      gap: 1rem;
    }
    
    .author-bio__links {
      justify-content: center;
    }
  }
</style>
