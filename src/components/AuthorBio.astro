---
import Icon from './Icon.astro';
import { SITE } from '../config';

const author = SITE.author;
const description = SITE.description;
const email = SITE.email;
const social = SITE.social;
---
<div class="author-bio">
  <div class="author-bio__avatar">
    <div class="author-bio__avatar-initial">{author.charAt(0)}</div>
  </div>
  <div class="author-bio__info">
    <h3 class="author-bio__name">{author}</h3>
    <p class="author-bio__desc">{description}</p>
    <div class="author-bio__links">
      {social.github && (
        <a href={social.github} target="_blank" rel="noopener noreferrer" class="author-bio__link" aria-label="GitHub">
          <Icon name="github" />
        </a>
      )}
      {social.linkedin && (
        <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="author-bio__link" aria-label="LinkedIn">
          <Icon name="linkedin" />
        </a>
      )}
      {email && (
        <a href={`mailto:${email}`} class="author-bio__link" aria-label="Email">
          <Icon name="mail" />
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .author-bio {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin: 4rem 0 2rem;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  @media (hover: hover) {
    .author-bio:hover {
      box-shadow: var(--shadow-card-hover);
      border-color: var(--color-accent-2);
    }
  }

  .author-bio__avatar {
    flex-shrink: 0;
  }

  .author-bio__avatar-initial {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-1), var(--color-accent-2), var(--color-accent-1));
    background-size: 200% 100%;
    animation: flowGradient 3s linear infinite;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-bg);
    font-family: var(--font-heading);
    box-shadow: var(--shadow-card);
  }

  [data-theme-mode="dark"] .author-bio__avatar-initial {
    box-shadow: var(--shadow-card-hover);
  }

  .author-bio__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .author-bio__name {
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .author-bio__desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .author-bio__links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .author-bio__link {
    color: var(--color-text-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (hover: hover) {
    .author-bio__link:hover {
      color: var(--color-accent-2);
      transform: translateY(-2px) scale(1.1);
    }
  }

  @media (max-width: 600px) {
    .author-bio {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
      gap: 1rem;
    }
    
    .author-bio__links {
      justify-content: center;
    }
  }
</style>
