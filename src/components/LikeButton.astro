---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
<div class="like-section">
  <button class="like-btn" id="like-btn" data-slug={slug}>
    <svg class="like-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <span class="like-btn__count" id="like-count">0</span>
  </button>
</div>

<script>
  const LIKES_API_URL = 'https://blog-likes.aarsh-blog-likes.workers.dev';
  const btn = document.getElementById('like-btn');
  const countSpan = document.getElementById('like-count');
  
  if (btn && countSpan) {
    const slug = btn.dataset.slug;
    
    const fetchLikes = async () => {
      try {
        const res = await fetch(`${LIKES_API_URL}/likes/${slug}`);
        if(res.ok) {
          const data = await res.json();
          countSpan.textContent = data.count || '0';
        }
      } catch (e) {
        console.error('Error fetching likes', e);
      }
    };
    fetchLikes();

    btn.addEventListener('click', async () => {
      if (localStorage.getItem(`liked-${slug}`)) {
        const oldText = countSpan.textContent;
        countSpan.textContent = 'Liked!';
        setTimeout(() => countSpan.textContent = oldText, 1500);
        return;
      }

      let current = parseInt(countSpan.textContent || '0', 10);
      countSpan.textContent = (current + 1).toString();
      btn.classList.add('like-btn--liked');
      localStorage.setItem(`liked-${slug}`, 'true');

      try {
        await fetch(`${LIKES_API_URL}/likes/${slug}`, { method: 'POST' });
      } catch (e) {
        console.error('Error posting like', e);
      }
    });
  }
</script>

<style>
  .like-section {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }
  .like-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    padding: 0.5rem 1.25rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text);
    transition: all 0.2s;
  }
  .like-btn:hover {
    border-color: var(--color-accent-1);
    color: var(--color-accent-1);
  }
  .like-btn__icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.2s;
  }
  .like-btn--liked .like-btn__icon {
    fill: var(--color-accent-1);
    stroke: var(--color-accent-1);
    animation: heart-burst 0.4s ease-out;
  }
  .like-btn--liked {
    border-color: var(--color-accent-1);
    color: var(--color-accent-1);
  }

  @keyframes heart-burst {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
</style>
