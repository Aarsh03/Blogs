---
import Icon from './Icon.astro';
---
<div id="custom-theme-toolbar" class="theme-toolbar" aria-hidden="true">
  <div class="theme-toolbar__mobile-strip">
    <div class="theme-toolbar__drag-handle" id="theme-toolbar-handle" title="Drag to move">
      <div class="drag-pill"></div>
    </div>
    <button class="theme-toolbar__rotate" id="theme-toolbar-rotate" title="Rotate Toolbar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
      </svg>
    </button>
  </div>
  <div class="theme-toolbar__row">
    <div class="theme-toolbar__drag-handle theme-toolbar__drag-handle--desktop" id="theme-toolbar-handle-desktop" title="Drag to move">
      <div class="drag-pill"></div>
    </div>
    <button class="theme-toolbar__rotate theme-toolbar__rotate--desktop" id="theme-toolbar-rotate-desktop" title="Rotate Toolbar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
      </svg>
    </button>
    <div class="theme-toolbar__divider"></div>
    <div class="theme-toolbar__bubbles">
      <div class="toolbar-bubble-wrapper" data-key="bg" data-title="Base: Main site background">
        <div class="toolbar-bubble" id="bubble-bg"></div>
        <span>Base</span>
      </div>
      <div class="toolbar-bubble-wrapper" data-key="card" data-title="Card: Post cards, panels, inputs">
        <div class="toolbar-bubble" id="bubble-card"></div>
        <span>Card</span>
      </div>
      <div class="toolbar-bubble-wrapper" data-key="text" data-title="Text: Main typography color">
        <div class="toolbar-bubble" id="bubble-text"></div>
        <span>Text</span>
      </div>
      <div class="toolbar-bubble-wrapper" data-key="accent1" data-title="Accent 1: Primary links">
        <div class="toolbar-bubble" id="bubble-accent1"></div>
        <span>Acc. 1</span>
      </div>
      <div class="toolbar-bubble-wrapper" data-key="accent2" data-title="Accent 2: Hover states">
        <div class="toolbar-bubble" id="bubble-accent2"></div>
        <span>Acc. 2</span>
      </div>
      <div class="toolbar-bubble-wrapper" data-key="accent3" data-title="Accent 3: Tag 3 color">
        <div class="toolbar-bubble" id="bubble-accent3"></div>
        <span>Acc. 3</span>
      </div>
      <div class="toolbar-bubble-wrapper" data-key="accent4" data-title="Accent 4: Tag 4 color">
        <div class="toolbar-bubble" id="bubble-accent4"></div>
        <span>Acc. 4</span>
      </div>
    </div>
    <div class="theme-toolbar__divider"></div>
    <div class="theme-toolbar__actions">
      <button id="toolbar-cancel" class="btn-icon btn-cancel" title="Cancel and Revert">
        <Icon name="close" />
      </button>
      <button id="toolbar-confirm" class="btn-icon btn-confirm" title="Save Theme">
        <Icon name="circle" />
      </button>
    </div>
  </div>
</div>

<style is:global>
  .theme-toolbar {
    position: fixed;
    top: 90px; left: 50%;
    transform: translateX(-50%);
    z-index: 10000;
    background: color-mix(in srgb, var(--color-bg-card) 90%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    box-shadow: var(--shadow-card-hover);
    opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, border-radius 0.3s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    width: max-content; max-width: 95vw;
    box-sizing: border-box;
  }
  .theme-toolbar[aria-hidden="false"] { opacity: 1; visibility: visible; }

  .theme-toolbar__mobile-strip { display: none; }

  .theme-toolbar__row {
    display: flex; align-items: center;
    padding: 0.5rem 0.75rem; gap: 0.75rem;
  }
  .theme-toolbar.vertical-mode { border-radius: 32px; }
  .theme-toolbar.vertical-mode .theme-toolbar__row { flex-direction: column; padding: 1rem 0.6rem; }
  .theme-toolbar.vertical-mode .theme-toolbar__drag-handle--desktop { transform: rotate(90deg); }
  .theme-toolbar.vertical-mode .theme-toolbar__bubbles { flex-direction: column; }
  .theme-toolbar.vertical-mode .theme-toolbar__actions { flex-direction: column; }
  .theme-toolbar.vertical-mode .theme-toolbar__divider { width: 24px; height: 1px; }

  .theme-toolbar__divider { width: 1px; height: 32px; background: var(--color-border); flex-shrink: 0; }

  .theme-toolbar__drag-handle {
    display: flex; justify-content: center; align-items: center;
    cursor: grab; flex-shrink: 0; color: var(--color-text-muted);
    padding: 0.25rem 0.3rem; border-radius: 8px;
  }
  .theme-toolbar__drag-handle:hover { background: color-mix(in srgb, var(--color-text) 5%, transparent); }
  .theme-toolbar__drag-handle:active { cursor: grabbing; }

  .drag-pill { width: 4px; height: 20px; border-radius: 2px; background: currentColor; opacity: 0.5; }

  .theme-toolbar__rotate {
    display: flex; justify-content: center; align-items: center;
    background: transparent; border: none; flex-shrink: 0;
    color: var(--color-text-muted); cursor: pointer;
    padding: 0; border-radius: 50%;
    width: 32px; height: 32px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .theme-toolbar__rotate:hover { background: color-mix(in srgb, var(--color-text) 8%, transparent); color: var(--color-text); }

  .theme-toolbar__bubbles { display: flex; gap: 0.6rem; align-items: center; }
  .toolbar-bubble-wrapper {
    display: flex; flex-direction: column; align-items: center;
    gap: 0.25rem; cursor: pointer; flex-shrink: 0;
  }
  .toolbar-bubble {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid var(--color-border); box-shadow: var(--shadow-card);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .toolbar-bubble-wrapper:hover .toolbar-bubble { transform: scale(1.15); }
  .toolbar-bubble-wrapper span {
    font-size: 0.55rem; font-family: var(--font-sans);
    color: var(--color-text-muted); font-weight: 500; text-transform: uppercase;
  }

  .theme-toolbar__actions { display: flex; gap: 0.5rem; align-items: center; flex-shrink: 0; }
  .btn-icon {
    display: flex; justify-content: center; align-items: center;
    width: 34px; height: 34px; border-radius: 50%;
    cursor: pointer; flex-shrink: 0;
    transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .btn-icon:active { transform: scale(0.9); }
  .btn-cancel { background: transparent; border: 1px solid var(--color-border); color: var(--color-text); }
  .btn-cancel:hover { background: color-mix(in srgb, var(--color-caution) 15%, transparent); color: var(--color-caution); border-color: transparent; }
  .btn-confirm { background: var(--color-accent-2); border: none; color: var(--color-bg); }
  .btn-confirm:hover { background: var(--color-success); }

  @media (max-width: 768px) {
    .theme-toolbar {
      top: auto !important; bottom: 80px !important;
      left: 50%; transform: translateX(-50%);
      border-radius: 20px;
      width: max-content; max-width: calc(100vw - 24px);
    }
    .theme-toolbar__drag-handle--desktop,
    .theme-toolbar__rotate--desktop,
    .theme-toolbar__divider { display: none !important; }

    .theme-toolbar__mobile-strip {
      display: flex; align-items: center;
      padding: 0.4rem 0.6rem;
      border-bottom: 1px solid var(--color-border);
      gap: 0.5rem;
    }
    .theme-toolbar__mobile-strip .theme-toolbar__drag-handle {
      flex: 1; justify-content: center; padding: 0.2rem;
    }
    .theme-toolbar__mobile-strip .drag-pill { width: 48px; height: 4px; }
    .theme-toolbar__mobile-strip .theme-toolbar__rotate { width: 32px; height: 32px; flex-shrink: 0; }

    .theme-toolbar__bubbles, .theme-toolbar__actions { display: contents; }
    .theme-toolbar__row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem 0.6rem;
      padding: 0.65rem 0.75rem 0.75rem;
      justify-items: center; align-items: center;
    }

    .theme-toolbar.vertical-mode { max-height: calc(100vh - 100px); }
    .theme-toolbar.vertical-mode .theme-toolbar__mobile-strip {
      flex-direction: column-reverse;
      padding: 0.6rem 0.4rem 0.4rem;
      gap: 0.5rem;
    }
    .theme-toolbar.vertical-mode .theme-toolbar__mobile-strip .theme-toolbar__drag-handle {
      flex: 0 0 auto;
    }
    .theme-toolbar.vertical-mode .theme-toolbar__mobile-strip .drag-pill {
      width: 24px; height: 4px;
    }
    .theme-toolbar.vertical-mode .theme-toolbar__row {
      grid-template-columns: 1fr;
      padding: 0.65rem 0.75rem 0.75rem;
    }
  }
</style>
