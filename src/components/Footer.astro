---
import { SITE } from '../config';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <p>&copy; {year} &middot; {SITE.author}</p>
    <div class="footer-links">
      <a href={SITE.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</footer>
<style>
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
  }
  .footer-links a {
    color: inherit;
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s ease, transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  @media (hover: hover) {
    .footer-links a:hover {
      color: var(--color-accent-1);
      transform: translateY(-2px) scale(1.05);
    }
  }
  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
