---
<div class="reading-progress-container">
  <div class="reading-progress-bar" id="reading-progress"></div>
</div>

<script>
  function updateProgress() {
    const progressBar = document.getElementById('reading-progress');
    if (!progressBar) return;

    // Use multiple fallbacks for cross-browser accuracy
    const scrollTop = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
    const scrollHeight = Math.max(
      document.body.scrollHeight, 
      document.documentElement.scrollHeight,
      document.body.offsetHeight, 
      document.documentElement.offsetHeight,
      document.body.clientHeight, 
      document.documentElement.clientHeight
    );
    const clientHeight = window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;
    
    // Calculate the maximum possible scroll amount
    const maxScroll = scrollHeight - clientHeight;
    
    let scrollPercent = 0;
    if (maxScroll > 0) {
      scrollPercent = scrollTop / maxScroll;
    }
    
    // Force 100% if we are within 20px of the very bottom (accounts for fractional scrollbar math issues)
    if (scrollTop + clientHeight >= scrollHeight - 20) {
      scrollPercent = 1;
    }
    
    progressBar.style.width = `${Math.min(100, Math.max(0, scrollPercent * 100))}%`;
  }

  // Update on scroll and resize
  document.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  
  // Use astro:page-load for View Transitions
  document.addEventListener('astro:page-load', updateProgress);
</script>

<style>
  .reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    z-index: 300;
    background: transparent;
    pointer-events: none;
  }
  
  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(to right, #d481a6, #9b8ac4);
    transition: width 0.1s ease-out;
    border-radius: 0 2px 2px 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  :global([data-theme="dark"]) .reading-progress-bar {
    background: linear-gradient(to right, var(--color-accent-1), var(--color-accent-2));
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }
</style>
