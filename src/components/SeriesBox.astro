---
import { getPublishedPosts } from '../utils/posts';

interface Props {
  seriesName: string;
  currentSlug: string;
}
const { seriesName, currentSlug } = Astro.props;

const allPublished = await getPublishedPosts();
const allPosts = allPublished.filter(p => p.data.series === seriesName);

// Sort by date ascending (oldest first) to get Part 1, Part 2, etc.
allPosts.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const currentIndex = allPosts.findIndex(p => p.id === currentSlug);
const totalParts = allPosts.length;
const base = import.meta.env.BASE_URL;
---

{totalParts > 1 && (
  <div class="series-box">
    <div class="series-box__header">
      <span class="series-box__label">Series</span>
      <h3 class="series-box__title">{seriesName}</h3>
      <span class="series-box__part">Part {currentIndex + 1} of {totalParts}</span>
    </div>
    <ul class="series-box__list">
      {allPosts.map((post, index) => {
        const isCurrent = post.id === currentSlug;
        return (
          <li class:list={['series-box__item', { 'is-current': isCurrent }]}>
            {isCurrent ? (
              <span class="series-box__link">Part {index + 1}: {post.data.title}</span>
            ) : (
              <a href={`${base}blog/${post.id}/`} class="series-box__link">Part {index + 1}: {post.data.title}</a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
)}

<style>
  .series-box {
    margin: 2rem 0;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--color-accent-2) 10%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .series-box__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .series-box__label {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 15%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .series-box__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-text);
  }

  .series-box__part {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .series-box__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .series-box__item {
    font-size: 0.95rem;
  }

  .series-box__item::before {
    content: '→';
    color: var(--color-accent-2);
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .series-box__item.is-current::before {
    opacity: 1;
  }

  .series-box__item.is-current .series-box__link {
    color: var(--color-text);
    font-weight: 600;
  }

  .series-box__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    a.series-box__link:hover {
      color: var(--color-accent-2);
    }
  }
</style>
