---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      if (window._giscusThemeObserver) {
        window._giscusThemeObserver.disconnect();
      }
      if (window._giscusIntersectObserver) {
        window._giscusIntersectObserver.disconnect();
      }

      const { repo, repoId, category, categoryId, baseUrl } = container.dataset;
      const cleanBase = baseUrl ? (baseUrl.endsWith('/') ? baseUrl : baseUrl + '/') : '/';
      const origin = window.location.origin;

      function getThemeMode() {
        let mode = document.documentElement.getAttribute('data-theme-mode');
        if (!mode) {
          const savedTheme = localStorage.getItem('theme') || 'obsidian';
          if (savedTheme === 'custom') {
            const customTheme = localStorage.getItem('customTheme');
            if (customTheme) {
              try {
                const parsed = JSON.parse(customTheme);
                if (parsed.bg) {
                  const r = parseInt(parsed.bg.slice(1,3), 16), g = parseInt(parsed.bg.slice(3,5), 16), b = parseInt(parsed.bg.slice(5,7), 16);
                  return ((0.2126 * r + 0.7152 * g + 0.0722 * b) < 128) ? 'dark' : 'light';
                }
              } catch(e) {}
            }
            return 'light';
          }
          const darkThemes = ['obsidian', 'rose', 'nebula', 'midnight-black'];
          mode = darkThemes.includes(savedTheme) ? 'dark' : 'light';
        }
        return mode;
      }

      function getGiscusThemeUrl() {
        const isDark = getThemeMode() === 'dark';
        if (window.location.protocol === 'http:') {
          return isDark ? 'transparent_dark' : 'light';
        }
        return isDark ? `${origin}${cleanBase}giscus-dark.css` : `${origin}${cleanBase}giscus-theme.css`;
      }

      function sendThemeToIframe(themeUrl: string) {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (!iframe || !iframe.contentWindow) return false;
        try {
          iframe.contentWindow.postMessage({ giscus: { setConfig: { theme: themeUrl } } }, 'https://giscus.app');
          return true;
        } catch (e) { return false; }
      }

      function startThemePulse() {
        if (window._giscusPulseInterval) clearInterval(window._giscusPulseInterval);
        let attempts = 0;
        window._giscusPulseInterval = setInterval(() => {
          const success = sendThemeToIframe(getGiscusThemeUrl());
          attempts++;
          if (attempts >= 15) clearInterval(window._giscusPulseInterval);
        }, 200);
      }

      window._giscusThemeObserver = new MutationObserver((mutations) => {
        let changed = false;
        mutations.forEach((m) => { if (m.attributeName === 'data-theme' || m.attributeName === 'data-theme-mode') changed = true; });
        if (changed) startThemePulse();
      });
      window._giscusThemeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-theme-mode'] });

      // Start pulse when giscus messages us (it's ready)
      window._giscusReadyListener = (event: MessageEvent) => {
        if (event.origin !== 'https://giscus.app' || typeof event.data !== 'object' || !event.data.giscus) return;
        if ('discussion' in event.data.giscus || 'error' in event.data.giscus) startThemePulse();
      };
      window.addEventListener('message', window._giscusReadyListener);

      if (container.hasChildNodes()) {
        startThemePulse();
      } else {
        window._giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const initialNativeTheme = getThemeMode() === 'dark' ? 'transparent_dark' : 'light';
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              script.setAttribute('data-theme', initialNativeTheme);
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              container.appendChild(script);
              window._giscusIntersectObserver?.disconnect();
              startThemePulse(); // Start pulsing immediately while it loads
            }
          });
        }, { rootMargin: '200px' });
        window._giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (window._giscusPulseInterval) clearInterval(window._giscusPulseInterval);
      if (window._giscusThemeObserver) { window._giscusThemeObserver.disconnect(); window._giscusThemeObserver = null; }
      if (window._giscusIntersectObserver) { window._giscusIntersectObserver.disconnect(); window._giscusIntersectObserver = null; }
      if (window._giscusReadyListener) { window.removeEventListener('message', window._giscusReadyListener); window._giscusReadyListener = null; }
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
