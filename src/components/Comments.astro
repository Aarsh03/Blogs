---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      // Clean up previous instances fully to avoid any view transition artifacts
      if (window._giscusThemeObserver) {
        window._giscusThemeObserver.disconnect();
      }
      if (window._giscusReadyListener) {
        window.removeEventListener('message', window._giscusReadyListener);
      }
      if (window._giscusIntersectObserver) {
        window._giscusIntersectObserver.disconnect();
      }

      const { repo, repoId, category, categoryId, baseUrl } = container.dataset;

      // Ensure baseUrl is clean
      const cleanBase = baseUrl ? (baseUrl.endsWith('/') ? baseUrl : baseUrl + '/') : '/';
      const origin = window.location.origin;

      function getGiscusThemeUrl() {
        const themeMode = document.documentElement.getAttribute('data-theme-mode');
        const theme = document.documentElement.getAttribute('data-theme');
        const isDark = themeMode === 'dark';
        
        console.log(`[Giscus Debug] Initializing theme... data-theme-mode: ${themeMode}, data-theme: ${theme}, isDark: ${isDark}`);
        
        // Use Giscus built-in themes for standard themes to eliminate custom CSS loading/caching bugs
        if (theme !== 'custom') {
          const url = isDark ? 'transparent_dark' : 'light';
          console.log(`[Giscus Debug] Using native Giscus theme: ${url}`);
          return url;
        }

        // Only use custom CSS for the actual "custom" theme picker
        const cb = '?t=' + Date.now(); 
        const url = isDark
          ? `${origin}${cleanBase}giscus-dark.css${cb}`
          : `${origin}${cleanBase}giscus-theme.css${cb}`;
          
        console.log(`[Giscus Debug] Using custom CSS URL: ${url}`);
        return url;
      }

      function sendThemeToIframe(themeUrl: string) {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (!iframe || !iframe.contentWindow) return;
        try {
          console.log(`[Giscus Debug] Sending postMessage with theme: ${themeUrl}`);
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: themeUrl } } },
            'https://giscus.app'
          );
        } catch (e) {
          console.warn('[Giscus Debug] postMessage origin mismatch - iframe booting up');
        }
      }

      function syncTheme() {
        sendThemeToIframe(getGiscusThemeUrl());
      }

      // 1. Observer for when the user manually switches themes
      window._giscusThemeObserver = new MutationObserver((mutations) => {
        let changed = false;
        mutations.forEach((m) => {
          if (m.attributeName === 'data-theme' || m.attributeName === 'data-theme-mode') changed = true;
        });
        if (changed) {
          console.log('[Giscus Debug] MutationObserver detected theme change!');
          syncTheme();
        }
      });
      window._giscusThemeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-theme-mode'],
      });

      // 2. Listener for when Giscus is completely ready
      window._giscusReadyListener = (event: MessageEvent) => {
        if (event.origin !== 'https://giscus.app') return;
        if (typeof event.data !== 'object' || !event.data.giscus) return;
        
        if ('discussion' in event.data.giscus || 'error' in event.data.giscus) {
          console.log('[Giscus Debug] Giscus sent discussion/error event (Ready!)');
          
          const targetThemeUrl = getGiscusThemeUrl();
          const isDark = document.documentElement.getAttribute('data-theme-mode') === 'dark';
          
          // Force a state transition inside Giscus React App:
          // 1. Switch to a standard built-in theme first to break any localStorage deadlocks
          console.log('[Giscus Debug] Forcing state transition pulse...');
          sendThemeToIframe(isDark ? 'dark' : 'light');
          
          // 2. Then apply the custom CSS URL 200ms later, repeating to ensure it sticks
          let attempts = 0;
          const pulseInterval = setInterval(() => {
            sendThemeToIframe(targetThemeUrl);
            attempts++;
            if (attempts >= 3) clearInterval(pulseInterval);
          }, 200);
        }
      };
      window.addEventListener('message', window._giscusReadyListener);

      // 3. Inject Giscus iframe lazily
      if (container.hasChildNodes()) {
        console.log('[Giscus Debug] Container already has Giscus (View Transition). Syncing...');
        syncTheme();
      } else {
        window._giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              console.log('[Giscus Debug] Container intersecting. Injecting script...');
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              
              // Initial injection URL
              const initialUrl = getGiscusThemeUrl();
              script.setAttribute('data-theme', initialUrl);
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              
              container.appendChild(script);
              window._giscusIntersectObserver?.disconnect();
            }
          });
        }, { rootMargin: '200px' });

        window._giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (window._giscusThemeObserver) {
        window._giscusThemeObserver.disconnect();
        window._giscusThemeObserver = null;
      }
      if (window._giscusIntersectObserver) {
        window._giscusIntersectObserver.disconnect();
        window._giscusIntersectObserver = null;
      }
      if (window._giscusReadyListener) {
        window.removeEventListener('message', window._giscusReadyListener);
        window._giscusReadyListener = null;
      }
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
