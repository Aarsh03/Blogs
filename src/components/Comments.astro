---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      // Clean up previous instances fully to avoid any view transition artifacts
      if (window._giscusThemeObserver) {
        window._giscusThemeObserver.disconnect();
      }
      if (window._giscusReadyListener) {
        window.removeEventListener('message', window._giscusReadyListener);
      }
      if (window._giscusIntersectObserver) {
        window._giscusIntersectObserver.disconnect();
      }

      const { repo, repoId, category, categoryId, baseUrl } = container.dataset;

      // Ensure baseUrl is clean
      const cleanBase = baseUrl ? (baseUrl.endsWith('/') ? baseUrl : baseUrl + '/') : '/';
      const origin = window.location.origin;

      function getThemeMode() {
        let mode = document.documentElement.getAttribute('data-theme-mode');
        if (!mode) {
          const savedTheme = localStorage.getItem('theme') || 'obsidian';
          const darkThemes = ['obsidian', 'rose', 'nebula', 'midnight-black'];
          mode = darkThemes.includes(savedTheme) ? 'dark' : 'light';
        }
        return mode;
      }

      function getGiscusThemeUrl() {
        const isDark = getThemeMode() === 'dark';
        return isDark
          ? `${origin}${cleanBase}giscus-dark.css`
          : `${origin}${cleanBase}giscus-theme.css`;
      }

      function sendThemeToIframe(themeUrl: string) {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (!iframe || !iframe.contentWindow) return;
        try {
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: themeUrl } } },
            'https://giscus.app'
          );
        } catch (e) {}
      }

      function syncTheme() {
        sendThemeToIframe(getGiscusThemeUrl());
      }

      window._giscusThemeObserver = new MutationObserver((mutations) => {
        let changed = false;
        mutations.forEach((m) => {
          if (m.attributeName === 'data-theme' || m.attributeName === 'data-theme-mode') changed = true;
        });
        if (changed) syncTheme();
      });
      window._giscusThemeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-theme-mode'],
      });

      window._giscusReadyListener = (event: MessageEvent) => {
        if (event.origin !== 'https://giscus.app') return;
        if (typeof event.data !== 'object' || !event.data.giscus) return;
        
        if ('discussion' in event.data.giscus || 'error' in event.data.giscus) {
          // Send native theme first. If custom CSS is blocked (e.g. on localhost), it falls back safely to this native theme.
          const isDark = getThemeMode() === 'dark';
          sendThemeToIframe(isDark ? 'transparent_dark' : 'light');
          
          let attempts = 0;
          const pulseInterval = setInterval(() => {
            syncTheme();
            attempts++;
            if (attempts >= 4) clearInterval(pulseInterval);
          }, 150);
        }
      };
      window.addEventListener('message', window._giscusReadyListener);

      if (container.hasChildNodes()) {
        syncTheme();
      } else {
        window._giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const isDark = getThemeMode() === 'dark';
              const initialNativeTheme = isDark ? 'transparent_dark' : 'light';
              
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              script.setAttribute('data-theme', initialNativeTheme);
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              
              container.appendChild(script);
              window._giscusIntersectObserver?.disconnect();
            }
          });
        }, { rootMargin: '200px' });

        window._giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (window._giscusThemeObserver) {
        window._giscusThemeObserver.disconnect();
        window._giscusThemeObserver = null;
      }
      if (window._giscusIntersectObserver) {
        window._giscusIntersectObserver.disconnect();
        window._giscusIntersectObserver = null;
      }
      if (window._giscusReadyListener) {
        window.removeEventListener('message', window._giscusReadyListener);
        window._giscusReadyListener = null;
      }
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
