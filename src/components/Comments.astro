---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    let _giscusThemeObserver: MutationObserver | null = null;
    let _giscusIntersectObserver: IntersectionObserver | null = null;
    let _giscusReadyListener: ((e: MessageEvent) => void) | null = null;

    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      _giscusThemeObserver?.disconnect();
      _giscusThemeObserver = null;
      _giscusIntersectObserver?.disconnect();
      _giscusIntersectObserver = null;

      if (_giscusReadyListener) {
        window.removeEventListener('message', _giscusReadyListener);
        _giscusReadyListener = null;
      }

      const { repo, repoId, category, categoryId, baseUrl } = container.dataset;

      function getGiscusTheme() {
        const isDark = document.documentElement.getAttribute('data-theme-mode') === 'dark';
        
        const lightCSS = `@import url('https://giscus.app/themes/light.css');main{--color-canvas-default:transparent!important;--color-canvas-overlay:transparent!important;--color-canvas-inset:rgba(0,0,0,0.04)!important;--color-canvas-subtle:rgba(0,0,0,0.04)!important;background:transparent!important;--color-border-default:rgba(0,0,0,0.1)!important;--color-border-muted:rgba(0,0,0,0.05)!important;--color-btn-primary-bg:#64748b!important;--color-btn-primary-border:#64748b!important;--color-btn-primary-hover-bg:#475569!important;--color-btn-primary-hover-border:#475569!important;--color-btn-primary-selected-bg:#334155!important;--color-btn-hover-bg:rgba(0,0,0,0.05)!important;--color-btn-hover-border:rgba(0,0,0,0.1)!important;--color-btn-primary-disabled-bg:rgba(100,116,139,0.5)!important;--color-btn-primary-disabled-border:transparent!important;--color-btn-primary-disabled-text:rgba(255,255,255,0.7)!important;--color-fg-default:#24292f!important;--color-fg-muted:#57606a!important;--color-fg-subtle:#6e7781!important;--color-accent-fg:#0969da!important}body{background-color:transparent!important}`;
        
        const darkCSS = `@import url('https://giscus.app/themes/transparent_dark.css');main{background:transparent!important;--color-btn-primary-bg:#475569!important;--color-btn-primary-border:#475569!important;--color-btn-primary-hover-bg:#64748b!important;--color-btn-primary-hover-border:#64748b!important;--color-btn-primary-selected-bg:#94a3b8!important;--color-btn-hover-bg:rgba(255,255,255,0.1)!important;--color-btn-hover-border:rgba(255,255,255,0.2)!important;--color-border-default:rgba(255,255,255,0.15)!important;--color-border-muted:rgba(255,255,255,0.1)!important;--color-btn-primary-disabled-bg:rgba(71,85,105,0.5)!important;--color-btn-primary-disabled-border:transparent!important;--color-btn-primary-disabled-text:rgba(255,255,255,0.4)!important;--color-fg-default:#c9d1d9!important;--color-fg-muted:#8b949e!important;--color-fg-subtle:#484f58!important;--color-accent-fg:#58a6ff!important}`;

        const css = isDark ? darkCSS : lightCSS;
        return 'data:text/css;base64,' + btoa(css);
      }

      function sendTheme() {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (iframe?.contentWindow) {
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: getGiscusTheme() } } },
            'https://giscus.app'
          );
        }
      }

      // Always wire up MutationObserver so theme switches work after any navigation
      _giscusThemeObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === 'data-theme' || mutation.attributeName === 'data-theme-mode') {
            sendTheme();
          }
        });
      });
      _giscusThemeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-theme-mode'],
      });

      // Always listen for Giscus "ready" message to push the correct theme the instant
      // the iframe finishes rendering. This handles initial load and BFCache restores.
      _giscusReadyListener = (event: MessageEvent) => {
        if (event.origin !== 'https://giscus.app') return;
        if (typeof event.data !== 'object' || !event.data.giscus) return;
        if ('discussion' in event.data.giscus || 'error' in event.data.giscus) {
          // Send theme multiple times to guarantee Giscus registers it, overriding its own localStorage
          let attempts = 0;
          const interval = setInterval(() => {
            sendTheme();
            attempts++;
            if (attempts >= 5) clearInterval(interval);
          }, 400);
        }
      };
      window.addEventListener('message', _giscusReadyListener);

      // If Giscus is already in the DOM (View Transition re-use), sync theme immediately
      if (container.hasChildNodes()) {
        // Small delay to let the iframe finish any pending re-render
        setTimeout(sendTheme, 100);
      } else {
        // Only setup IntersectionObserver if Giscus hasn't been injected yet
        _giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              script.setAttribute('data-theme', getGiscusTheme());
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              container.appendChild(script);
              _giscusIntersectObserver?.disconnect();
            }
          });
        }, { rootMargin: '200px' });

        _giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      _giscusThemeObserver?.disconnect();
      _giscusThemeObserver = null;
      _giscusIntersectObserver?.disconnect();
      _giscusIntersectObserver = null;
      if (_giscusReadyListener) {
        window.removeEventListener('message', _giscusReadyListener);
        _giscusReadyListener = null;
      }
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
