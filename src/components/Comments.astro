---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      // Cleanup previous instances
      if (window._giscusThemeObserver) window._giscusThemeObserver.disconnect();
      if (window._giscusIntersectObserver) window._giscusIntersectObserver.disconnect();

      const { repo, repoId, category, categoryId, baseUrl } = container.dataset;
      const cleanBase = baseUrl ? (baseUrl.endsWith('/') ? baseUrl : baseUrl + '/') : '/';
      const origin = window.location.origin;

      const DARK_THEMES = ['obsidian', 'rose', 'nebula', 'midnight-black'];

      function isDarkMode(): boolean {
        // First try the already-set attribute (set by BaseLayout inline script)
        const mode = document.documentElement.getAttribute('data-theme-mode');
        if (mode) return mode === 'dark';

        // Fallback: calculate from localStorage
        const savedTheme = localStorage.getItem('theme') || 'obsidian';
        if (savedTheme === 'custom') {
          try {
            const p = JSON.parse(localStorage.getItem('customTheme') || '{}');
            if (p.bg) {
              const r = parseInt(p.bg.slice(1,3), 16), g = parseInt(p.bg.slice(3,5), 16), b = parseInt(p.bg.slice(5,7), 16);
              return (0.2126 * r + 0.7152 * g + 0.0722 * b) < 128;
            }
          } catch(e) {}
          return false;
        }
        return DARK_THEMES.includes(savedTheme);
      }

      /**
       * Returns the Giscus theme URL with a cache-busting query parameter.
       * 
       * WHY CACHE BUSTING IS CRITICAL:
       * Giscus aggressively caches custom CSS URLs internally. If you switch
       * from dark→light, Giscus may ignore the new URL because it thinks
       * the CSS hasn't changed (same domain, similar path). By appending
       * a unique `?t=<timestamp>` parameter, Giscus always treats it as
       * a fresh theme request and re-fetches the CSS.
       */
      function getGiscusThemeUrl(): string {
        const dark = isDarkMode();
        // On localhost (http:), Giscus rejects custom CSS URLs, so use native themes
        if (window.location.protocol === 'http:') {
          return dark ? 'transparent_dark' : 'light';
        }
        const file = dark ? 'giscus-dark.css' : 'giscus-theme.css';
        return `${origin}${cleanBase}${file}?t=${Date.now()}`;
      }

      function sendThemeToGiscus() {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (!iframe?.contentWindow) return;
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: getGiscusThemeUrl() } } },
          'https://giscus.app'
        );
      }

      // Watch for theme changes on <html> and update Giscus
      window._giscusThemeObserver = new MutationObserver((mutations) => {
        if (mutations.some(m => m.attributeName === 'data-theme' || m.attributeName === 'data-theme-mode')) {
          sendThemeToGiscus();
        }
      });
      window._giscusThemeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-theme-mode'],
      });

      // When Giscus signals it's ready, send the correct theme
      window._giscusReadyListener = (event: MessageEvent) => {
        if (event.origin !== 'https://giscus.app') return;
        if (typeof event.data !== 'object' || !event.data.giscus) return;
        if ('discussion' in event.data.giscus || 'error' in event.data.giscus) {
          sendThemeToGiscus();
        }
      };
      window.addEventListener('message', window._giscusReadyListener);

      if (container.hasChildNodes()) {
        // Already loaded (e.g. view transition), just sync theme
        sendThemeToGiscus();
      } else {
        // Lazy-load Giscus when the container scrolls into view
        window._giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Use native theme for initial load (no cache issue with native themes)
              const initialTheme = isDarkMode() ? 'transparent_dark' : 'light';
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              script.setAttribute('data-theme', initialTheme);
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              container.appendChild(script);
              window._giscusIntersectObserver?.disconnect();
            }
          });
        }, { rootMargin: '200px' });
        window._giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (window._giscusThemeObserver) { window._giscusThemeObserver.disconnect(); window._giscusThemeObserver = null; }
      if (window._giscusIntersectObserver) { window._giscusIntersectObserver.disconnect(); window._giscusIntersectObserver = null; }
      if (window._giscusReadyListener) { window.removeEventListener('message', window._giscusReadyListener); window._giscusReadyListener = null; }
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
