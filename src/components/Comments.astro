---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    let _giscusThemeObserver: MutationObserver | null = null;
    let _giscusIntersectObserver: IntersectionObserver | null = null;

    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      _giscusThemeObserver?.disconnect();
      _giscusThemeObserver = null;
      _giscusIntersectObserver?.disconnect();
      _giscusIntersectObserver = null;

      const { repo, repoId, category, categoryId, baseUrl } = container.dataset;

      function getGiscusTheme() {
        const isDark = document.documentElement.getAttribute('data-theme-mode') === 'dark';
        const base = baseUrl ? (baseUrl.endsWith('/') ? baseUrl : baseUrl + '/') : '/';
        const cb = '?t=' + Date.now(); 
        return isDark
          ? `${window.location.origin + base}giscus-dark.css${cb}`
          : `${window.location.origin + base}giscus-theme.css${cb}`;
      }

      function sendTheme() {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (iframe?.contentWindow) {
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: getGiscusTheme() } } },
            'https://giscus.app'
          );
        }
      }

      // Brute-force theme sync: Continuously send the theme every 500ms for 10 seconds on page load.
      // This completely overrides any internal race conditions, stale localStorage, or missed events in Giscus.
      let bruteForceAttempts = 0;
      const bruteForceInterval = setInterval(() => {
        sendTheme();
        bruteForceAttempts++;
        if (bruteForceAttempts >= 20) clearInterval(bruteForceInterval);
      }, 500);

      // Always wire up MutationObserver so theme switches work after any navigation
      _giscusThemeObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === 'data-theme' || mutation.attributeName === 'data-theme-mode') {
            sendTheme();
          }
        });
      });
      _giscusThemeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-theme-mode'],
      });

      // Note: We no longer rely on Giscus sending a "discussion" event because 
      // strict privacy settings/adblockers can sometimes block Giscus from sending it.

      // If Giscus is already in the DOM (View Transition re-use), sync theme immediately
      if (container.hasChildNodes()) {
        // Small delay to let the iframe finish any pending re-render
        setTimeout(sendTheme, 100);
      } else {
        // Only setup IntersectionObserver if Giscus hasn't been injected yet
        _giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              script.setAttribute('data-theme', getGiscusTheme());
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              container.appendChild(script);
              _giscusIntersectObserver?.disconnect();
            }
          });
        }, { rootMargin: '200px' });

        _giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      _giscusThemeObserver?.disconnect();
      _giscusThemeObserver = null;
      _giscusIntersectObserver?.disconnect();
      _giscusIntersectObserver = null;
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
