---
import { SITE } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---
<section id="comments" class="comments-section">
  <h2 class="comments-section__title">Comments</h2>
  <div class="giscus-container" data-repo={SITE.giscus.repo} data-repo-id={SITE.giscus.repoId} data-category={SITE.giscus.category} data-category-id={SITE.giscus.categoryId} data-base-url={baseUrl}></div>
  <script>
    import { GISCUS_DARK_THEME, GISCUS_LIGHT_THEME } from '../utils/giscusThemes';

    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.giscus-container') as HTMLElement;
      if (!container) return;

      if (window._giscusThemeObserver) window._giscusThemeObserver.disconnect();
      if (window._giscusIntersectObserver) window._giscusIntersectObserver.disconnect();

      const { repo, repoId, category, categoryId } = container.dataset;
      const DARK_THEMES = ['obsidian', 'rose', 'nebula', 'midnight-black'];

      function isDarkMode(): boolean {
        const mode = document.documentElement.getAttribute('data-theme-mode');
        if (mode) return mode === 'dark';
        const savedTheme = localStorage.getItem('theme') || 'obsidian';
        if (savedTheme === 'custom') {
          try {
            const p = JSON.parse(localStorage.getItem('customTheme') || '{}');
            if (p.bg) {
              const r = parseInt(p.bg.slice(1,3), 16), g = parseInt(p.bg.slice(3,5), 16), b = parseInt(p.bg.slice(5,7), 16);
              return (0.2126 * r + 0.7152 * g + 0.0722 * b) < 128;
            }
          } catch(e) {}
          return false;
        }
        return DARK_THEMES.includes(savedTheme);
      }

      function getGiscusTheme(): string {
        const dark = isDarkMode();
        if (window.location.protocol === 'http:') {
          return dark ? 'transparent_dark' : 'light';
        }
        // Using Base64 encoded Data URIs for the theme guarantees 100% reliability.
        // It bypasses all Giscus iframe caching, network failures, or race conditions.
        return dark ? GISCUS_DARK_THEME : GISCUS_LIGHT_THEME;
      }

      function sendThemeToGiscus() {
        const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
        if (!iframe?.contentWindow) return;
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: getGiscusTheme() } } },
          'https://giscus.app'
        );
      }

      window._giscusThemeObserver = new MutationObserver((mutations) => {
        if (mutations.some(m => m.attributeName === 'data-theme' || m.attributeName === 'data-theme-mode')) {
          sendThemeToGiscus();
        }
      });
      window._giscusThemeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-theme-mode'],
      });

      if (container.hasChildNodes()) {
        sendThemeToGiscus();
      } else {
        window._giscusIntersectObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', repo || '');
              script.setAttribute('data-repo-id', repoId || '');
              script.setAttribute('data-category', category || '');
              script.setAttribute('data-category-id', categoryId || '');
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              
              // Pass the Base64 Data URI directly on initial load!
              script.setAttribute('data-theme', getGiscusTheme());
              script.setAttribute('data-lang', 'en');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;
              container.appendChild(script);
              window._giscusIntersectObserver?.disconnect();
            }
          });
        }, { rootMargin: '200px' });
        window._giscusIntersectObserver.observe(container);
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (window._giscusThemeObserver) { window._giscusThemeObserver.disconnect(); window._giscusThemeObserver = null; }
      if (window._giscusIntersectObserver) { window._giscusIntersectObserver.disconnect(); window._giscusIntersectObserver = null; }
    });
  </script>
</section>
<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments-section__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
