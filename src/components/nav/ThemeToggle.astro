---
// ThemeToggle.astro
---
<button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
  <svg id="icon-sun" class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg id="icon-moon" class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;

    /**
     * Show the correct icon using inline style !important — this has the highest
     * CSS cascade priority and cannot be overridden by any stylesheet rule.
     * We target by ID so Astro's class scoping cannot interfere.
     */
    function setIconVisibility(theme: string) {
      const sun  = document.getElementById('icon-sun');
      const moon = document.getElementById('icon-moon');
      if (!sun || !moon) return;
      if (theme === 'dark') {
        sun.style.setProperty('display', 'block', 'important');
        moon.style.setProperty('display', 'none', 'important');
      } else {
        sun.style.setProperty('display', 'none', 'important');
        moon.style.setProperty('display', 'block', 'important');
      }
    }

    function applyTheme(theme: string) {
      html.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      setIconVisibility(theme);
    }

    const initialTheme = html.getAttribute('data-theme') || 'light';
    // Set icons based on already-resolved theme (head script ran before body)
    setIconVisibility(initialTheme);

    // Sync settings toggle if it exists
    function syncSettingsThemeToggle(theme: string) {
      const settingsThemeToggle = document.getElementById('settings-theme-toggle');
      if (settingsThemeToggle) {
        const isDark = theme === 'dark';
        settingsThemeToggle.setAttribute('aria-checked', String(isDark));
        settingsThemeToggle.classList.toggle('on', isDark);
      }
    }
    syncSettingsThemeToggle(initialTheme);

    toggleBtn?.addEventListener('click', () => {
      const isDark = html.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      applyTheme(newTheme);
      syncSettingsThemeToggle(newTheme);
    });
  });
</script>
