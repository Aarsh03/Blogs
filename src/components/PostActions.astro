---
import Icon from './Icon.astro';
import ShareButtons from './ShareButtons.astro';

interface Props {
  slug: string;
  title: string;
}
const { slug, title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="post-actions">
  <!-- Back to home -->
  <a href={base} class="back-btn" aria-label="Back to all posts">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"/>
      <polyline points="12 19 5 12 12 5"/>
    </svg>
    All Posts
  </a>

  <div class="actions-right">
    <ShareButtons title={title} />
    
    <!-- Jump to Comments -->
    <a href="#comments" class="comment-btn" aria-label="Jump to comments">
      <Icon name="message-circle" class="comment-btn__icon" />
      <span class="comment-btn__label">Comment</span>
    </a>

    <!-- Like button -->
    <button class="like-btn" id="like-btn" data-slug={slug} aria-label="Like this post">
      <svg class="like-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span class="like-btn__count" id="like-count">—</span>
    </button>
  </div>
</div>

<script>
  import { SITE } from '../config';
  const LIKES_API_URL = SITE.likesApiUrl;

  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('like-btn') as HTMLButtonElement | null;
    const countSpan = document.getElementById('like-count');

    if (btn && countSpan) {
      const slug = btn.dataset.slug;

      // Restore liked state on load
      if (localStorage.getItem(`liked-${slug}`)) {
        btn.classList.add('like-btn--liked');
      }

      const fetchLikes = async () => {
        try {
          const res = await fetch(`${LIKES_API_URL}/likes/${slug}`);
          if (res.ok) {
            const data = await res.json();
            countSpan.textContent = data.count ?? '0';
          } else {
            countSpan.textContent = '0';
          }
        } catch (e) {
          console.error('Error fetching likes', e);
        }
      };
      fetchLikes();

      // Remove any existing listeners by cloning (if needed, but page-load runs after DOM swap so btn is fresh)
      // Actually, since Astro swaps the DOM, `btn` is a new element every time, 
      // so we don't need to worry about duplicate event listeners.
      btn.addEventListener('click', async () => {
        if (localStorage.getItem(`liked-${slug}`)) {
          // Already liked — wiggle
          btn.classList.add('wiggle');
          setTimeout(() => {
            btn.classList.remove('wiggle');
          }, 500);
          return;
        }

        const parsed = parseInt(countSpan.textContent || '0', 10);
        const current = Number.isNaN(parsed) ? 0 : parsed;
        countSpan.textContent = (current + 1).toString();
        btn.classList.add('like-btn--liked');
        localStorage.setItem(`liked-${slug}`, 'true');

        try {
          await fetch(`${LIKES_API_URL}/likes/${slug}`, { method: 'POST' });
        } catch (e) {
          console.error('Error posting like', e);
        }
      });
    }
  });
</script>

<style>
  .post-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }
  
  .actions-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* ── Back button ── */
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.22s ease, border-color 0.22s ease, background-color 0.22s ease, transform 0.22s ease;
  }

  @media (hover: hover) {
    .back-btn:hover {
      border-color: var(--color-accent-2);
      color: var(--color-accent-2);
      background: color-mix(in srgb, var(--color-accent-2) 10%, transparent);
      transform: translateX(-3px);
      text-decoration: none;
    }

    .back-btn:hover svg {
      transform: translateX(-3px);
    }
  }

  /* ── Like & Comment buttons ── */
  .like-btn, .comment-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1.5px solid var(--color-accent-2);
    border-radius: 999px;
    padding: 0.5rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent-2);
    transition: color 0.22s ease, border-color 0.22s ease, background-color 0.22s ease, transform 0.22s ease;
    user-select: none;
    text-decoration: none;
  }

  @media (hover: hover) {
    .like-btn:hover, .comment-btn:hover {
      border-color: var(--color-code-text);
      color: var(--color-code-text);
      background: color-mix(in srgb, var(--color-code-text) 10%, transparent);
      transform: scale(1.04);
    }
  }

  .like-btn__icon, :global(.comment-btn__icon) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .like-btn--liked {
    border-color: var(--color-code-text);
    color: var(--color-code-text);
    background: color-mix(in srgb, var(--color-code-text) 15%, transparent);
    box-shadow: none;
  }

  @media (hover: hover) {
    .like-btn--liked:hover {
      border-color: var(--color-code-text);
      color: var(--color-code-text);
      background: color-mix(in srgb, var(--color-code-text) 15%, transparent);
      box-shadow: none;
    }
  }

  .like-btn--liked .like-btn__icon {
    fill: var(--color-code-text);
    stroke: var(--color-code-text);
    animation: heart-burst 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes heart-burst {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.4); }
    70%  { transform: scale(0.9); }
    100% { transform: scale(1); }
  }

  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    20%       { transform: rotate(-12deg); }
    60%       { transform: rotate(12deg); }
  }

  .like-btn.wiggle {
    animation: wiggle 0.5s ease;
  }

  @media (max-width: 768px) {
    .post-actions {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 1.5rem;
    }
    .actions-right {
      justify-content: space-between;
      width: 100%;
    }
    .back-btn {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .like-btn__count, .comment-btn__label {
      font-size: 0.85rem;
    }
    .actions-right {
      gap: 0.5rem;
    }
    .like-btn, .comment-btn {
      padding: 0.5rem 0.75rem;
    }
  }
</style>
