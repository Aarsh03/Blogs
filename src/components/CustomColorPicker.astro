---
---
<div id="custom-color-picker" class="custom-color-picker" aria-hidden="true" style="transform: translate(-50%, -50%); top: 50%; left: 50%;">
  <div class="picker-header" id="picker-drag-handle">
    <div class="picker-drag-indicator"></div>
    <span id="picker-title" class="picker-title">Color Picker</span>
  </div>
  <div class="picker-content">
    <div class="picker-visuals">
      <div class="sv-area" id="sv-area">
        <div class="sv-bg-hue" id="sv-bg-hue"></div>
        <div class="sv-bg-white"></div>
        <div class="sv-bg-black"></div>
        <div class="sv-cursor" id="sv-cursor"></div>
      </div>
      <div class="slider-group">
        <div class="color-preview" id="picker-preview"></div>
        <input type="range" class="hue-slider" id="hue-slider" min="0" max="360" value="0" />
      </div>
    </div>
    <div class="picker-inputs">
      <div class="input-group"><label>HEX</label><input type="text" id="input-hex" placeholder="#FFFFFF" /></div>
      <div class="input-group"><label>RGB</label><input type="text" id="input-rgb" placeholder="255, 255, 255" /></div>
      <div class="input-group"><label>HSL</label><input type="text" id="input-hsl" placeholder="0, 0%, 100%" /></div>
      <div class="input-group"><label>CMYK</label><input type="text" id="input-cmyk" placeholder="0%, 0%, 0%, 0%" /></div>
    </div>
    <div class="picker-actions">
      <button class="btn-cancel" id="picker-cancel">Cancel</button>
      <button class="btn-confirm" id="picker-confirm">Select</button>
    </div>
  </div>
</div>

<style is:global>
  .custom-color-picker {
    position: fixed;
    z-index: 10005;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: var(--shadow-card-hover);
    width: 320px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .custom-color-picker[aria-hidden="false"] {
    opacity: 1; visibility: visible;
  }
  .picker-header {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    cursor: grab;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--color-text) 3%, transparent);
    border-radius: 16px 16px 0 0;
  }
  .picker-header:active { cursor: grabbing; }
  .picker-drag-indicator {
    width: 36px; height: 4px;
    border-radius: 4px;
    background: var(--color-text-light);
  }
  .picker-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.3;
  }
  .picker-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .sv-area {
    width: 100%; height: 160px;
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    cursor: crosshair;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
  }
  .sv-bg-hue { position: absolute; inset: 0; background-color: #ff0000; }
  .sv-bg-white { position: absolute; inset: 0; background: linear-gradient(to right, #fff, rgba(255,255,255,0)); }
  .sv-bg-black { position: absolute; inset: 0; background: linear-gradient(to top, #000, rgba(0,0,0,0)); }
  .sv-cursor {
    width: 16px; height: 16px;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 4px rgba(0,0,0,0.5);
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .slider-group {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
  }
  .color-preview {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .hue-slider {
    flex-grow: 1;
    -webkit-appearance: none;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(to right, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
    outline: none;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
  }
  .hue-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--color-border);
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
    cursor: pointer;
  }
  .picker-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .input-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .input-group label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    width: 40px;
  }
  .input-group input {
    flex-grow: 1;
    background: var(--color-bg-code);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    outline: none;
  }
  .input-group input:focus {
    border-color: var(--color-accent-2);
  }
  .picker-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .picker-actions button {
    flex: 1;
    padding: 0.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.8rem;
    cursor: pointer;
  }
</style>
